---
import '../styles/global.css';
import { getPageSeo } from '../lib/page-seo.js';
import Tracking from '../components/Tracking.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  socialImage?: string;
}

const {
  title = "Pacific West Home Builders · ADUs",
  description = "Pacific West designs, permits and builds accessory dwelling units across Southern California. Custom detached ADUs, garage conversions, and additions.",
  canonical,
  socialImage
} = Astro.props;

const seo = await getPageSeo(`${Astro.url.pathname}${Astro.url.search}`, { title, description, canonical, socialImage });
const seoTitle = seo.title || title;
const seoDescription = seo.description || description;
const seoCanonical = seo.canonical || canonical;
const seoImage = seo.socialImage || socialImage;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{seoTitle}</title>
  {seoDescription && <meta name="description" content={seoDescription} />}
  {seo.noIndex && <meta name="robots" content="noindex, nofollow" />}
  {seoCanonical && <link rel="canonical" href={seoCanonical} />}
  {seoCanonical && <meta property="og:url" content={seoCanonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={seo.openGraphTitle || seoTitle} />
  {seoDescription && <meta property="og:description" content={seo.openGraphDescription || seoDescription} />}
  <meta name="twitter:card" content={seoImage ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={seo.openGraphTitle || seoTitle} />
  {seoDescription && <meta name="twitter:description" content={seo.openGraphDescription || seoDescription} />}
  {seoImage && <meta property="og:image" content={seoImage} />}
  {seoImage && <meta name="twitter:image" content={seoImage} />}
  <link rel="icon" type="image/png" href="/assets/logo-black.png" />
  
  <!-- Google Fonts: Poppins & Cormorant Garamond -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Poppins:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,600;1,700;1,800&display=swap" rel="stylesheet" />
  <Tracking />
</head>
<body class="bg-[#111111] text-[#1C1B1A] font-sans antialiased overflow-x-hidden selection:bg-[#AB0000] selection:text-white">
  <Tracking position="body" />
  <slot />

  <!-- Universal Client Interactivity -->
  <script is:inline>
    // Universal smooth scroll helper matching go(id)
    window.go = function(id) {
      const el = document.getElementById(id);
      if (el) {
        const topPos = el.getBoundingClientRect().top + window.scrollY - 84;
        window.scrollTo({
          top: topPos,
          behavior: 'smooth'
        });
      }
    };

    // Global intersection observer for scroll reveal animations
    document.addEventListener('DOMContentLoaded', () => {
      const reveals = document.querySelectorAll('.reveal-item');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });

        reveals.forEach(el => io.observe(el));
      } else {
        reveals.forEach(el => el.classList.add('is-visible'));
      }

      // Safe Form Lead Proxy Handler (landing_master_process compliance)
      const forms = document.querySelectorAll('form[data-lead-form]');
      forms.forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = form.querySelector('button[type="submit"]');
          const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
          const showStatus = (message, success) => {
            let status = form.querySelector('[data-form-status]');
            if (!status) {
              status = document.createElement('p');
              status.dataset.formStatus = '';
              status.setAttribute('role', 'status');
              form.prepend(status);
            }
            status.className = `col-span-full text-sm leading-6 ${success ? 'text-green-700' : 'text-[#AB0000]'}`;
            status.textContent = message;
          };

          const payload = {
            name: form.querySelector('[name="name"]')?.value?.trim() || '',
            phone: form.querySelector('[name="phone"]')?.value?.trim() || '',
            email: form.querySelector('[name="email"]')?.value?.trim() || '',
            address: form.querySelector('[name="address"]')?.value?.trim() || '',
            adu_type: form.querySelector('[name="adu_type"]')?.value?.trim() || '',
            message: form.querySelector('[name="message"]')?.value?.trim() || '',
            landing: form.dataset.landing || 'pacific-v5-adu',
            full_url: window.location.href,
            timestamp: new Date().toISOString()
          };

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.75';
            submitBtn.style.cursor = 'not-allowed';
            submitBtn.innerHTML = '<span style="display:inline-flex;align-items:center;gap:8px;"><svg class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10" fill="none"/></svg> Submitting...</span>';
          }

          try {
            // Intento primero con PHP (Cloudways / Apache) o Cloudflare Functions
            const endpoint = window.location.hostname.includes('pages.dev') ? '/api/submit-lead' : '/api/submit-lead.php';
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify(payload)
            });
            if (!response.ok) throw new Error(`Lead endpoint returned ${response.status}`);
            showStatus('Thank you. Your request has been sent. Our team will be in touch soon.', true);
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.style.cursor = 'default';
              submitBtn.innerHTML = 'Request sent';
            }
          } catch (err) {
            console.warn('Lead submission failed:', err);
            showStatus('We could not send your request. Please try again or call (888) 398-4499.', false);
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.style.opacity = '';
              submitBtn.style.cursor = '';
              submitBtn.innerHTML = originalBtnHtml;
            }
          }
        });
      });
    });
  </script>
</body>
</html>
