---
import { getWebsiteSettings } from '../lib/sanity-content.js';

const settings = await getWebsiteSettings();
const phone = settings.phone || '(888) 398-4499';
const phoneLink = settings.phoneLink || 'tel:8883984499';

const ADU_TYPES = [
  'Detached ADU',
  'Attached ADU',
  'Garage Conversion',
  'JADU',
  'Second-story ADU',
  'Not sure yet'
];

interface Props {
  title?: string;
  kicker?: string;
  intro?: string;
  label?: string;
  options?: string[];
  image?: string;
  imageAlt?: string;
  selectPlaceholder?: string;
  landing?: string;
}

const {
  title = 'Let’s see what your lot can hold',
  kicker = 'Start your ADU',
  intro = 'Tell us about your property and an ADU specialist will call to schedule your site visit.',
  label = 'ADU type',
  options = ADU_TYPES,
  image = '/assets/imagery/contact-kitchen.png',
  imageAlt = 'ADU kitchen',
  selectPlaceholder = 'Select ADU Type',
  landing = 'pacific-v5-adu'
} = Astro.props;
---

<section id="contact" class="v5-contact grid grid-cols-1 min-[901px]:grid-cols-2">
  
  <!-- Left Side: Architectural Photo & Call Action -->
  <div class="relative min-h-[500px] min-[901px]:min-h-[86vh] text-white overflow-hidden">
    <img 
      src={image}
      alt={imageAlt}
      class="w-full h-full object-cover object-center absolute inset-0 block"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/10 pointer-events-none"></div>
    
    <div class="absolute left-[clamp(20px,4vw,72px)] right-[clamp(20px,4vw,72px)] bottom-[clamp(20px,4vw,72px)] pointer-events-none">
      <div class="flex items-center gap-4 text-[12px] font-semibold tracking-[0.24em] uppercase text-white">
        <span class="w-14 h-[1px] bg-[#AB0000]"></span>
        <span>Free site visit</span>
      </div>
      
      <h2 class="mt-6 font-sans font-semibold text-[clamp(34px,4vw,68px)] leading-[0.98] tracking-[-0.015em] uppercase text-white max-w-[500px] text-balance">
        {title}
      </h2>

      <a 
        href={phoneLink}
        class="inline-flex items-center gap-3.5 mt-9 text-white text-[22px] font-light transition-opacity hover:opacity-85 pointer-events-auto"
      >
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>{phone}</span>
      </a>
    </div>
  </div>

  <!-- Right Side: Form Card -->
  <div class="px-[clamp(20px,4vw,72px)] py-[clamp(56px,7vw,112px)] bg-white text-[#1C1B1A]">
    <div class="flex items-center gap-4 text-[12px] font-semibold tracking-[0.24em] uppercase text-[#AB0000]">
      <span class="w-14 h-[1px] bg-[#AB0000]"></span>
      <span>{kicker}</span>
    </div>

    <p class="mt-6 mb-10 font-light text-[16px] leading-[1.7] text-[#55524D] max-w-[440px]">
      {intro}
    </p>

    <!-- Safe Lead Proxy Form -->
    <form data-lead-form data-landing={landing} class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <!-- Full Name -->
      <label class="flex flex-col gap-2">
        <span class="text-[11px] font-medium tracking-[0.14em] uppercase text-[#1C1B1A]">
          Full name <span class="text-[#AB0000]">*</span>
        </span>
        <input 
          type="text" 
          name="name" 
          placeholder="Jane Doe" 
          required 
          class="w-full font-sans font-light text-[15px] text-[#1C1B1A] bg-white border border-[#C9C4BB] rounded-[2px] px-4 py-3.5 outline-none transition-all duration-200 focus:border-[#1C1B1A] focus:ring-2 focus:ring-[#AB0000]/20"
        />
      </label>

      <!-- Phone -->
      <label class="flex flex-col gap-2">
        <span class="text-[11px] font-medium tracking-[0.14em] uppercase text-[#1C1B1A]">
          Phone <span class="text-[#AB0000]">*</span>
        </span>
        <input 
          type="tel" 
          name="phone" 
          placeholder="(000) 000-0000" 
          required 
          class="w-full font-sans font-light text-[15px] text-[#1C1B1A] bg-white border border-[#C9C4BB] rounded-[2px] px-4 py-3.5 outline-none transition-all duration-200 focus:border-[#1C1B1A] focus:ring-2 focus:ring-[#AB0000]/20"
        />
      </label>

      <!-- Property Address -->
      <label class="flex flex-col gap-2 col-span-full">
        <span class="text-[11px] font-medium tracking-[0.14em] uppercase text-[#1C1B1A]">
          Property address
        </span>
        <input 
          type="text" 
          name="address" 
          placeholder="Street, city" 
          class="w-full font-sans font-light text-[15px] text-[#1C1B1A] bg-white border border-[#C9C4BB] rounded-[2px] px-4 py-3.5 outline-none transition-all duration-200 focus:border-[#1C1B1A] focus:ring-2 focus:ring-[#AB0000]/20"
        />
      </label>

      <!-- ADU Type Dropdown -->
      <label class="flex flex-col gap-2 col-span-full">
        <span class="text-[11px] font-medium tracking-[0.14em] uppercase text-[#1C1B1A]">
          {label}
        </span>
        <div class="relative">
          <select 
            name="adu_type" 
            class="w-full appearance-none font-sans font-light text-[15px] text-[#1C1B1A] bg-white border border-[#C9C4BB] rounded-[2px] px-4 py-3.5 pr-11 outline-none transition-all duration-200 focus:border-[#1C1B1A] focus:ring-2 focus:ring-[#AB0000]/20 cursor-pointer"
          >
            <option value="" disabled selected>{selectPlaceholder}</option>
            {options.map(t => (
              <option value={t}>{t}</option>
            ))}
          </select>
          <span class="absolute right-4 top-1/2 -translate-y-[60%] w-2 h-2 border-r border-b border-[#1C1B1A] rotate-45 pointer-events-none" aria-hidden="true"></span>
        </div>
      </label>

      <!-- Project Details -->
      <label class="flex flex-col gap-2 col-span-full">
        <span class="text-[11px] font-medium tracking-[0.14em] uppercase text-[#1C1B1A]">
          Project details
        </span>
        <textarea 
          name="message" 
          rows="3" 
          placeholder="Tell us about what you have in mind..." 
          class="w-full font-sans font-light text-[15px] text-[#1C1B1A] bg-white border border-[#C9C4BB] rounded-[2px] px-4 py-3.5 outline-none resize-y transition-all duration-200 focus:border-[#1C1B1A] focus:ring-2 focus:ring-[#AB0000]/20"
        ></textarea>
      </label>

      <!-- Consent & Submit -->
      <div class="col-span-full flex justify-between items-center gap-5 flex-wrap mt-2">
        <label class="inline-flex items-start gap-3 cursor-pointer text-[13px] font-light leading-snug text-[#55524D] select-none">
          <input 
            type="checkbox" 
            name="consent" 
            checked 
            required 
            class="mt-0.5 rounded-[1px] accent-[#AB0000] w-4 h-4 cursor-pointer"
          />
          <span>I agree to be contacted about my project.</span>
        </label>

        <button 
          type="submit" 
          class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.18em] uppercase px-[26px] py-[17px] bg-[#AB0000] text-white cursor-pointer whitespace-nowrap transition-colors duration-300 hover:bg-[#8F0000] active:scale-[0.98]"
        >
          <span>Send request</span>
          <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </button>
      </div>
    </form>
  </div>

</section>
