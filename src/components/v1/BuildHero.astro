---
const STAGES = [
  {
    k: 'Pacific West',
    t: 'Your ADU, built start to finish',
    d: 'Pacific West designs, permits and builds accessory dwelling units across Southern California. Scroll to watch one go up.',
    src: '/assets/imagery/build/00-completed-adu-hero.png',
    slot: 'Completed ADU hero',
    h1: true,
    intro: true
  },
  {
    k: 'Property review',
    t: 'Property review, concept & plans',
    d: 'We survey your lot, confirm setbacks, utilities and zoning, and draw concept plans for what your property can hold.',
    src: '/assets/imagery/build/01-property-review.jpg',
    slot: 'Property review'
  },
  {
    k: 'Permitting',
    t: 'Permitting & site preparation',
    d: 'We take the plans through city plan check. Once approved, the crew clears the pad, sets string lines and excavates the footings.',
    src: '/assets/imagery/build/02-site-prep.jpg',
    slot: 'Permitting'
  },
  {
    k: 'Foundation',
    t: 'Foundation & slab',
    d: 'Engineered footings, rebar, anchor bolts and utility stub-outs, inspected and poured into a level slab.',
    src: '/assets/imagery/build/03-foundation.jpg',
    slot: 'Foundation'
  },
  {
    k: 'Framing',
    t: 'Walls, framing & roof structure',
    d: 'Walls, shear panels and roof rafters go up to the engineer’s plan, with hold-downs for California seismic code.',
    src: '/assets/imagery/build/04-framing.jpg',
    slot: 'Framing'
  },
  {
    k: 'Enclosure',
    t: 'Roofing, windows & exterior enclosure',
    d: 'Roofing, house wrap, flashed windows and the entry door. The unit is now sealed against the weather.',
    src: '/assets/imagery/build/05-enclosure.jpg',
    slot: 'Enclosure'
  },
  {
    k: 'Rough-in',
    t: 'Plumbing, electrical, HVAC & insulation',
    d: 'Supply and drain lines, wiring, ducting and insulation are installed and inspected before the walls close.',
    src: '/assets/imagery/build/06-rough-in.jpg',
    slot: 'Rough-in'
  },
  {
    k: 'Finishes',
    t: 'Interior & exterior finishes',
    d: 'Drywall, flooring, cabinetry and paint inside; stucco, lighting and hardscape outside.',
    src: '/assets/imagery/build/07-interior.jpg',
    slot: 'Finishes'
  },
  {
    k: 'Move-in',
    t: 'Final inspections, walkthrough & completed ADU',
    d: 'Final city inspection, certificate of occupancy and a walkthrough with your project lead. Then it’s yours to rent, share or live in.',
    src: '/assets/imagery/build/08-completed.jpg',
    slot: 'Move-in',
    cta: true
  }
];

const N = STAGES.length;
---

<section id="top" class="build-hero-wrap relative bg-[#111111]" style={`height: calc(100vh + ${N * 70}vh);`}>
  <!-- Sticky Viewport (100vh) -->
  <div id="build-stage" class="sticky top-0 h-screen w-full overflow-hidden text-white select-none">
    
    <!-- Background Slides Layer (z-index: 1) -->
    <div class="slides-container absolute inset-0 pt-[84px] z-[1]">
      {STAGES.map((st, idx) => (
        <div 
          class={`stage-slide absolute inset-0 transition-opacity duration-[1100ms] ease-in-out ${idx === 0 ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'}`}
          data-stage-index={idx}
          style={`z-index: ${idx === 0 ? 1 : 0};`}
        >
          <div class="slide-inner absolute inset-0 transition-transform duration-[2600ms] ease-out" style={idx === 0 ? 'transform: scale(1);' : 'transform: scale(1.06);'}>
            <img 
              src={st.src} 
              alt={st.t} 
              class="w-full h-full object-cover object-center block"
              loading={idx === 0 ? "eager" : "lazy"}
            />
          </div>
        </div>
      ))}
    </div>

    <!-- Architectural Gradient Vignette Layer (z-index: 2) -->
    <div 
      class="absolute inset-0 z-[2] pointer-events-none"
      style="background: linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(0,0,0,.72) 100%), linear-gradient(90deg, rgba(0,0,0,.45), rgba(0,0,0,0) 60%);"
    ></div>

    <!-- Jobsite Laser Level & Elevation Follower (z-index: 3) -->
    <div id="surveyor-box" aria-hidden="true" class="absolute inset-0 pointer-events-none transition-opacity duration-300 z-[3]" style="opacity: 1;">
      
      <!-- Horizontal Laser Level Beam -->
      <div 
        id="surveyor-laser-line" 
        class="absolute left-0 right-0 top-0 h-[1.5px] will-change-transform"
        style="background: linear-gradient(90deg, rgba(255,43,43,0.05) 0%, rgba(255,43,43,0.7) 15%, #ff4d4d 50%, rgba(255,43,43,0.7) 85%, rgba(255,43,43,0.05) 100%); box-shadow: 0 0 10px rgba(255,43,43,0.6);"
      ></div>

      <!-- Surveyor Transit Scope & Plumb Marker -->
      <div 
        id="surveyor-scope" 
        class="absolute left-0 top-0 w-10 h-10 -ml-5 -mt-5 rounded-full border border-white/70 bg-black/60 backdrop-blur-[4px] grid place-items-center will-change-transform shadow-[0_0_18px_rgba(0,0,0,0.85)] transition-[border-color,box-shadow,transform] duration-200"
      >
        <!-- Horizontal level reticle cross marks -->
        <span class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-[1px] bg-white/50 pointer-events-none"></span>
        <span class="absolute top-1 bottom-1 left-1/2 -translate-x-1/2 w-[1px] bg-[#ff3b3b]/60 pointer-events-none"></span>
        
        <!-- Central Laser Diode -->
        <span id="surveyor-diode" class="w-2 h-2 rounded-full bg-[#ff2b2b] shadow-[0_0_8px_#ff2b2b,0_0_2px_#ffffff] z-10 transition-colors duration-200"></span>
        
        <!-- Short Vertical Plumb Drop Line (38px) -->
        <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[1.5px] h-9 bg-gradient-to-b from-[#ff3b3b] to-transparent flex flex-col items-center justify-end">
          <span class="w-1.5 h-1.5 rounded-full bg-[#ff2b2b] shadow-[0_0_6px_#ff2b2b] -mb-0.5"></span>
        </div>
      </div>

      <!-- Architectural Elevation & Distance HUD Badge -->
      <div 
        id="surveyor-hud" 
        class="absolute left-0 top-0 flex items-center gap-2.5 px-3 py-1.5 bg-[#0e0e0e]/95 border border-white/25 text-white font-mono text-[11px] tracking-wider whitespace-nowrap will-change-transform shadow-[0_8px_25px_rgba(0,0,0,0.9)] rounded-sm transition-[border-color,background-color] duration-200"
      >
        <span id="surveyor-hud-dot" class="w-1.5 h-1.5 rounded-full bg-[#ff2b2b] shadow-[0_0_6px_#ff2b2b] transition-colors duration-200"></span>
        <span id="surveyor-hud-text" class="font-medium text-white/95">▲ ELEV: +0′ 0″ · DIST: 22′ 4″ · DRAFTING</span>
      </div>

    </div>

    <!-- Dynamic Stage Content (z-index: 4) -->
    <div class="absolute z-[4] left-[clamp(20px,4vw,72px)] right-[clamp(20px,4vw,72px)] bottom-[clamp(56px,10vh,120px)] max-w-[980px] pointer-events-none">
      {STAGES.map((st, idx) => (
        <div 
          class={`stage-caption-item ${idx === 0 ? 'block' : 'hidden'}`}
          data-caption-index={idx}
        >
          <!-- Kicker -->
          <div class="flex items-center gap-4 text-[12px] font-semibold tracking-[0.24em] uppercase text-[#ff6b6b]" style="animation: v4Rise 0.8s var(--ease-out) both;">
            {!st.intro && (
              <span class="text-[22px] font-medium tracking-normal">{String(idx).padStart(2, '0')}</span>
            )}
            <span class="w-14 h-[1px] bg-[#ff6b6b]"></span>
            <span>{st.k}</span>
          </div>

          <!-- Headline -->
          {st.h1 ? (
            <h1 class="mt-6 font-sans font-semibold text-[clamp(40px,5.6vw,100px)] leading-[0.94] tracking-[-0.02em] uppercase text-balance text-white" style="animation: v4Rise 0.9s var(--ease-out) 80ms both;">
              {st.t}
            </h1>
          ) : (
            <h2 class="mt-6 font-sans font-semibold text-[clamp(40px,5.6vw,100px)] leading-[0.94] tracking-[-0.02em] uppercase text-balance text-white" style="animation: v4Rise 0.9s var(--ease-out) 80ms both;">
              {st.t}
            </h2>
          )}

          <!-- Description -->
          <p class="mt-6.5 max-w-[620px] text-[clamp(16px,1.25vw,20px)] font-light leading-[1.6] text-white/90 text-pretty" style="animation: v4Rise 0.9s var(--ease-out) 160ms both;">
            {st.d}
          </p>

          <!-- CTAs on Final Stage -->
          {st.cta && (
            <div class="flex gap-3 flex-wrap mt-[34px] pointer-events-auto" style="animation: v4Rise 0.9s var(--ease-out) 240ms both;">
              <button 
                type="button" 
                onclick="window.go('types')"
                class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.18em] uppercase px-[26px] py-[17px] bg-[#AB0000] text-white cursor-pointer transition-colors duration-300 hover:bg-[#8F0000]"
              >
                <span>Explore ADU types</span>
              </button>
              <button 
                type="button" 
                onclick="window.go('calculator')"
                class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.18em] uppercase px-[26px] py-[17px] border border-white text-white bg-transparent cursor-pointer transition-colors duration-300 hover:bg-white hover:text-black"
              >
                <span>Estimate my cost</span>
              </button>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Right Side Step Indicator Dots (Hidden <= 760px, z-index: 4) -->
    <div class="v4-dots absolute z-[4] right-[clamp(20px,4vw,72px)] top-1/2 -translate-y-1/2 flex flex-col gap-2.5">
      {STAGES.map((st, idx) => (
        <button 
          type="button" 
          class="stage-dot-btn flex items-center justify-end gap-3 bg-transparent border-none cursor-pointer text-white font-sans text-[11px] tracking-[0.16em] uppercase py-1 transition-all duration-400 group"
          data-dot-index={idx}
          title={st.intro ? 'Start' : st.k}
          style={idx === 0 ? 'opacity: 1;' : 'opacity: 0.45;'}
        >
          <span 
            class="dot-label transition-opacity duration-300" 
            style={idx === 0 ? 'opacity: 1;' : 'opacity: 0;'}
          >
            {st.intro ? 'Start' : st.k}
          </span>
          <span 
            class="dot-line h-[1px] transition-all duration-400" 
            style={idx === 0 ? 'width: 28px; background: #AB0000;' : 'width: 12px; background: #ffffff;'}
          ></span>
        </button>
      ))}
    </div>

    <!-- Initial Scroll Prompt at Stage 0 (z-index: 5) -->
    <button 
      type="button" 
      id="scroll-prompt" 
      class="absolute z-[5] left-0 right-0 bottom-7 mx-auto w-fit flex items-center gap-3 text-[11px] tracking-[0.3em] text-white/80 hover:text-white cursor-pointer transition-colors duration-200 outline-none select-none bg-transparent border-none p-2 pointer-events-auto" 
      style="animation: v4Rise 1s var(--ease-out) 0.6s both;"
      aria-label="Scroll to build stages"
    >
      <span>SCROLL TO BUILD</span>
      <svg class="w-3.5 h-3.5 text-white animate-bounce pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <polyline points="19 12 12 19 5 12"></polyline>
      </svg>
    </button>

    <!-- Bottom Scrubber Progress Bar (z-index: 4) -->
    <div class="absolute z-[4] left-0 right-0 bottom-0 h-1 bg-white/10">
      <div id="build-progress-fill" class="absolute inset-0 bg-[#AB0000] origin-left scale-x-0 will-change-transform"></div>
    </div>

  </div>
</section>

<!-- BuildHero Client Controller -->
<script is:inline>
  function initBuildHeroV1() {
    const wrap = document.querySelector('.build-hero-wrap');
    const stage = document.getElementById('build-stage');
    const fill = document.getElementById('build-progress-fill');
    const slides = Array.from(document.querySelectorAll('.stage-slide'));
    const captions = Array.from(document.querySelectorAll('.stage-caption-item'));
    const dots = Array.from(document.querySelectorAll('.stage-dot-btn'));
    const scrollPrompt = document.getElementById('scroll-prompt');
    const N = slides.length;
    let currentIdx = -1;

    // Jobsite Laser Level & Elevation Follower
    const surveyorBox = document.getElementById('surveyor-box');
    const surveyorLaserLine = document.getElementById('surveyor-laser-line');
    const surveyorScope = document.getElementById('surveyor-scope');
    const surveyorDiode = document.getElementById('surveyor-diode');
    const surveyorHud = document.getElementById('surveyor-hud');
    const surveyorHudText = document.getElementById('surveyor-hud-text');
    const surveyorHudDot = document.getElementById('surveyor-hud-dot');

    let isHoveringInteractive = false;
    let interactiveTargetName = '';
    let lastX = 0;
    let lastY = 0;

    const ELEVATION_STAGES = [
      { elev: '+0′ 0″', label: 'GROUND ZERO · DRAFTING' },
      { elev: '+1′ 6″', label: '01 DESIGN & PLANS' },
      { elev: '+3′ 2″', label: '02 CITY PERMITS' },
      { elev: '+5′ 6″', label: '03 FOUNDATION SLAB' },
      { elev: '+11′ 8″', label: '04 2x6 FRAMING' },
      { elev: '+14′ 0″', label: '05 DRYWALL & ROUGH-IN' },
      { elev: '+16′ 6″', label: '06 LUXURY FINISHES' },
      { elev: '+18′ 4″', label: '07 HARDSCAPE & PATIO' },
      { elev: '+20′ 0″', label: '08 FINAL INSPECTION' },
      { elev: '+20′ 0″', label: '09 MOVE-IN READY' }
    ];

    function formatFeetInches(pixels, totalPixels, maxFeet) {
      const totalInches = Math.round((Math.max(0, Math.min(pixels, totalPixels)) / (totalPixels || 1)) * (maxFeet * 12));
      const ft = Math.floor(totalInches / 12);
      const inc = totalInches % 12;
      return `${ft}′ ${inc}″`;
    }

    function setSurveyorPosition(x, y, r) {
      if (!surveyorBox) return;
      surveyorBox.style.opacity = '1';
      lastX = x;
      lastY = y;

      // Laser horizontal line tracks vertical cursor position
      if (surveyorLaserLine) surveyorLaserLine.style.transform = `translateY(${y}px)`;

      // Surveyor transit scope tracks exact (x, y)
      if (surveyorScope) surveyorScope.style.transform = `translate3d(${x}px, ${y}px, 0)`;

      // HUD badge tracks with smart edge flip & floats neatly above laser line
      const flip = x > r.width - 290;
      if (surveyorHud) {
        const hudY = y > 70 ? y - 38 : y + 22;
        surveyorHud.style.transform = `translate3d(${flip ? x - 275 : x + 28}px, ${hudY}px, 0)`;
      }

      // Calculate horizontal span (footprint distance across 40ft site)
      const distDim = formatFeetInches(x, r.width, 40);
      const currentStage = ELEVATION_STAGES[Math.max(0, Math.min(currentIdx, ELEVATION_STAGES.length - 1))] || ELEVATION_STAGES[0];

      if (surveyorHudText) {
        if (isHoveringInteractive && interactiveTargetName) {
          surveyorHudText.textContent = `● TARGET LOCK: ${interactiveTargetName}`;
        } else {
          surveyorHudText.textContent = `▲ ELEV: ${currentStage.elev} · DIST: ${distDim} · ${currentStage.label}`;
        }
      }
    }

    if (stage) {
      const rInit = stage.getBoundingClientRect();
      const initX = Math.round((rInit.width || window.innerWidth) * 0.56);
      const initY = Math.round((rInit.height || window.innerHeight) * 0.52);
      setSurveyorPosition(initX, initY, rInit);

      stage.addEventListener('mousemove', (e) => {
        const r = stage.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        setSurveyorPosition(x, y, r);
      });

      stage.addEventListener('mouseleave', () => {
        if (surveyorBox) surveyorBox.style.opacity = '0.8';
      });

      stage.addEventListener('mouseenter', () => {
        if (surveyorBox) surveyorBox.style.opacity = '1';
      });

      // Interactive hover states on buttons and stage elements
      const interactiveElements = stage.querySelectorAll('button, a, .stage-dot-btn, input');
      interactiveElements.forEach((el) => {
        el.addEventListener('mouseenter', () => {
          isHoveringInteractive = true;
          interactiveTargetName = (el.textContent || '').trim().replace(/\s+/g, ' ').toUpperCase() || 'SELECT';
          if (surveyorScope) {
            surveyorScope.style.borderColor = '#ffffff';
            surveyorScope.style.boxShadow = '0 0 25px rgba(255, 43, 43, 0.8), 0 0 0 1px #ffffff';
          }
          if (surveyorHud) {
            surveyorHud.style.borderColor = '#ff3b3b';
            surveyorHud.style.backgroundColor = 'rgba(28, 6, 6, 0.96)';
          }
          if (surveyorDiode) {
            surveyorDiode.style.backgroundColor = '#ffffff';
            surveyorDiode.style.boxShadow = '0 0 10px #ffffff';
          }
          if (surveyorHudDot) {
            surveyorHudDot.style.backgroundColor = '#ffffff';
            surveyorHudDot.style.boxShadow = '0 0 8px #ffffff';
          }
          const r = stage.getBoundingClientRect();
          setSurveyorPosition(lastX, lastY, r);
        });

        el.addEventListener('mouseleave', () => {
          isHoveringInteractive = false;
          interactiveTargetName = '';
          if (surveyorScope) {
            surveyorScope.style.borderColor = 'rgba(255, 255, 255, 0.7)';
            surveyorScope.style.boxShadow = '0 0 18px rgba(0, 0, 0, 0.85)';
          }
          if (surveyorHud) {
            surveyorHud.style.borderColor = 'rgba(255, 255, 255, 0.25)';
            surveyorHud.style.backgroundColor = 'rgba(14, 14, 14, 0.95)';
          }
          if (surveyorDiode) {
            surveyorDiode.style.backgroundColor = '#ff2b2b';
            surveyorDiode.style.boxShadow = '0 0 8px #ff2b2b, 0 0 2px #ffffff';
          }
          if (surveyorHudDot) {
            surveyorHudDot.style.backgroundColor = '#ff2b2b';
            surveyorHudDot.style.boxShadow = '0 0 6px #ff2b2b';
          }
          const r = stage.getBoundingClientRect();
          setSurveyorPosition(lastX, lastY, r);
        });
      });
    }

    // High performance scroll listener with RAF
    let ticking = false;

    function updateHero() {
      if (!wrap) return;
      const r = wrap.getBoundingClientRect();
      const total = wrap.offsetHeight - window.innerHeight;
      if (total <= 0) return;

      const p = Math.min(1, Math.max(0, -r.top / total));

      // Update bottom scrubber bar
      if (fill) fill.style.transform = `scaleX(${p})`;

      const activeIdx = Math.min(N - 1, Math.floor(p * N));

      if (activeIdx !== currentIdx) {
        currentIdx = activeIdx;

        // Switch slides
        slides.forEach((sl, idx) => {
          const inner = sl.querySelector('.slide-inner');
          if (idx === activeIdx) {
            sl.style.opacity = '1';
            sl.style.zIndex = '1';
            sl.style.pointerEvents = 'auto';
            if (inner) inner.style.transform = 'scale(1)';
          } else {
            sl.style.opacity = '0';
            sl.style.zIndex = '0';
            sl.style.pointerEvents = 'none';
            if (inner) inner.style.transform = 'scale(1.06)';
          }
        });

        // Switch captions
        captions.forEach((cp, idx) => {
          if (idx === activeIdx) {
            cp.classList.remove('hidden');
            cp.classList.add('block');
          } else {
            cp.classList.remove('block');
            cp.classList.add('hidden');
          }
        });

        // Switch dots
        dots.forEach((dot, idx) => {
          const line = dot.querySelector('.dot-line');
          const label = dot.querySelector('.dot-label');
          if (idx === activeIdx) {
            dot.style.opacity = '1';
            if (line) {
              line.style.width = '28px';
              line.style.background = '#AB0000';
            }
            if (label) label.style.opacity = '1';
          } else {
            dot.style.opacity = '0.45';
            if (line) {
              line.style.width = '12px';
              line.style.background = '#ffffff';
            }
            if (label) label.style.opacity = '0';
          }
        });

        // Update surveyor elevation indicator dynamically as ADU rises
        if (surveyorHudText && !isHoveringInteractive && stage) {
          const r = stage.getBoundingClientRect();
          const distDim = formatFeetInches(lastX, r.width, 40);
          const currentStage = ELEVATION_STAGES[Math.max(0, Math.min(currentIdx, ELEVATION_STAGES.length - 1))] || ELEVATION_STAGES[0];
          surveyorHudText.textContent = `▲ ELEV: ${currentStage.elev} · DIST: ${distDim} · ${currentStage.label}`;
        }

        // Scroll prompt visibility
        if (scrollPrompt) {
          scrollPrompt.style.opacity = activeIdx === 0 ? '1' : '0';
          scrollPrompt.style.pointerEvents = activeIdx === 0 ? 'auto' : 'none';
        }
      }

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(updateHero);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    updateHero();

    // Click on scroll prompt to jump smoothly to Stage 1 (01 DESIGN & PRE-CONSTRUCTION)
    if (scrollPrompt) {
      scrollPrompt.addEventListener('click', () => {
        const total = wrap.offsetHeight - window.innerHeight;
        const targetTop = wrap.offsetTop + (total * 1.5) / N;
        window.scrollTo({
          top: targetTop,
          behavior: 'smooth'
        });
      });
    }

    // Click on dots to jump smoothly to stage
    dots.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        const total = wrap.offsetHeight - window.innerHeight;
        const targetTop = wrap.offsetTop + (total * (idx + 0.5)) / N;
        window.scrollTo({
          top: targetTop,
          behavior: 'smooth'
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBuildHeroV1);
  } else {
    initBuildHeroV1();
  }
</script>


