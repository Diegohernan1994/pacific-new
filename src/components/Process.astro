---
const DEFAULT_STEPS = [
  {
    title: 'Site visit',
    desc: 'We walk your lot, check setbacks, utilities and access, and tell you which ADU types qualify.'
  },
  {
    title: 'Design',
    desc: 'Floor plan, elevations and finishes, drawn around how you plan to use the unit.'
  },
  {
    title: 'Engineering',
    desc: 'Structural, Title 24 energy and soils reports, coordinated by our team.'
  },
  {
    title: 'Plan check',
    desc: 'We submit to the city, answer corrections and track every comment until approval.'
  },
  {
    title: 'Build',
    desc: 'Our own crews build it, with a project lead on site and weekly updates.'
  },
  {
    title: 'Final & move-in',
    desc: 'Final inspection, certificate of occupancy and a walkthrough before handover.'
  }
];
const { content = {} } = Astro.props;
const STEPS = content.steps?.length ? content.steps.map((step) => ({ title: step.title, desc: step.description || step.desc })) : DEFAULT_STEPS;
const kicker = content.kicker || 'Permit process';
const title = content.title || 'From first visit to permit, we handle the city';
---

<section id="process" class="process-section px-[clamp(20px,4vw,72px)] py-[clamp(88px,10vw,160px)] bg-[#111111] text-white">
  <!-- Section Title -->
  <div class="reveal-item">
    <div class="flex items-center gap-4 text-[12px] font-semibold tracking-[0.24em] uppercase text-[#ff6b6b]">
      <span class="w-14 h-[1px] bg-[#ff6b6b]"></span>
        <span>{kicker}</span>
    </div>
    <h2 class="mt-7 font-sans font-semibold text-[clamp(36px,4.6vw,76px)] leading-[0.98] tracking-[-0.015em] uppercase text-white max-w-[1000px] text-balance">
      {title}
    </h2>
  </div>

  <!-- Timeline Container -->
  <div class="relative mt-[clamp(56px,7vw,104px)]">
    
    <!-- DESKTOP (>= 1024px): Horizontal Progress Line -->
    <div class="hidden lg:block absolute left-0 right-0 top-0 h-[1px] bg-white/20">
      <div id="process-progress-fill-h" class="absolute inset-0 bg-[#AB0000] origin-left scale-x-0 will-change-transform transition-transform duration-150"></div>
    </div>

    <!-- MOBILE / TABLET (< 1024px): Vertical Progress Line on the Left -->
    <div class="lg:hidden absolute left-[5px] top-2 bottom-8 w-[2px] bg-white/20">
      <div id="process-progress-fill-v" class="absolute inset-0 bg-[#AB0000] origin-top scale-y-0 will-change-transform transition-transform duration-150"></div>
    </div>

    <!-- Steps Grid / Vertical Stack -->
    <div class="flex flex-col lg:grid lg:grid-cols-6 lg:gap-x-8">
      {STEPS.map((st, idx) => (
        <div 
          class="process-step-item relative pl-8 pb-10 last:pb-0 lg:pl-0 lg:pb-0 lg:pt-7" 
          data-step-index={idx}
        >
          <!-- Node Dot: centered on vertical line in mobile, on horizontal line in desktop -->
          <span 
            class="step-node absolute left-[5px] -translate-x-1/2 top-1.5 lg:top-[-4px] lg:left-0 lg:translate-x-0 w-[11px] h-[11px] rounded-full bg-[#111111] border-2 border-white/40 transition-all duration-400 z-10"
          ></span>
          
          <!-- Step Number -->
          <div class="step-num text-[13px] font-medium text-white/50 transition-colors duration-400">
            {String(idx + 1).padStart(2, '0')}
          </div>

          <!-- Step Title -->
          <div class="text-[20px] font-semibold uppercase mt-1 lg:mt-3.5 tracking-[0.01em]">
            {st.title}
          </div>

          <!-- Step Description -->
          <p class="mt-2 lg:mt-3 text-[14px] font-light leading-[1.7] text-white/75 max-w-[500px] lg:max-w-none">
            {st.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process Client Controller -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.process-section');
    const fillH = document.getElementById('process-progress-fill-h');
    const fillV = document.getElementById('process-progress-fill-v');
    const stepItems = Array.from(document.querySelectorAll('.process-step-item'));
    const totalSteps = stepItems.length;

    function updateProcess() {
      if (!section) return;
      const r = section.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.85 - r.top) / (r.height + window.innerHeight * 0.2)));

      // Sync horizontal fill in desktop
      if (fillH) fillH.style.transform = `scaleX(${p})`;

      // Sync vertical fill in mobile
      if (fillV) fillV.style.transform = `scaleY(${p})`;

      stepItems.forEach((item, idx) => {
        const threshold = (idx + 0.35) / totalSteps;
        const isOn = p >= threshold;
        const node = item.querySelector('.step-node');
        const num = item.querySelector('.step-num');

        if (isOn) {
          if (node) {
            node.style.background = '#AB0000';
            node.style.borderColor = '#AB0000';
            node.style.boxShadow = '0 0 10px rgba(171, 0, 0, 0.6)';
          }
          if (num) {
            num.style.color = '#ff6b6b';
          }
        } else {
          if (node) {
            node.style.background = '#111111';
            node.style.borderColor = 'rgba(255, 255, 255, 0.4)';
            node.style.boxShadow = 'none';
          }
          if (num) {
            num.style.color = 'rgba(255, 255, 255, 0.5)';
          }
        }
      });
    }

    window.addEventListener('scroll', updateProcess, { passive: true });
    window.addEventListener('resize', updateProcess);
    updateProcess();
  });
</script>
