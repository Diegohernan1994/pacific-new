---
const DEFAULT_TYPES = [
  {
    n: 'Detached ADU',
    tag: 'A separate home in your backyard',
    d: 'A freestanding one- or two-bedroom home with its own entry, kitchen and bath. The most private option and the strongest for rental income.',
    size: 'Up to 1,200 sq ft',
    where: 'Backyard',
    best: 'Rental income, guest house',
    src: '/assets/imagery/types/detached-adu.jpg'
  },
  {
    n: 'Attached ADU',
    tag: 'An addition with its own front door',
    d: 'Built onto the side or rear of your home, sharing a wall but not a living space. Ties into existing utilities, which keeps site work down.',
    size: 'Up to 1,200 sq ft or 50% of the home',
    where: 'Side or rear of house',
    best: 'Multigenerational family',
    src: '/assets/imagery/types/attached-adu.jpg'
  },
  {
    n: 'Garage Conversion',
    tag: 'Turn the garage into a home',
    d: 'We keep the existing slab and walls where we can, then insulate, re-frame openings and add a kitchen and bath. Often the fastest path to an ADU.',
    size: 'Existing footprint',
    where: 'Attached or detached garage',
    best: 'Lower cost, faster build',
    src: '/assets/imagery/types/garage-conversion.jpg'
  },
  {
    n: 'JADU',
    tag: 'A suite inside your existing home',
    d: 'A junior ADU carved from an existing bedroom or wing, with an efficiency kitchen and its own entrance. Bath can be private or shared.',
    size: 'Up to 500 sq ft',
    where: 'Inside the main house',
    best: 'Aging parents, adult kids',
    src: '/assets/imagery/types/jadu.jpg'
  },
  {
    n: 'Second-story ADU',
    tag: 'Build up and keep the yard',
    d: 'A new unit above your garage or as an upper level, with its own stair and entry. Ideal for smaller lots where yard space matters.',
    size: 'Up to 1,200 sq ft',
    where: 'Above garage or home',
    best: 'Small lots, views',
    src: '/assets/imagery/types/second-story-adu.jpg'
  }
];
const { items = DEFAULT_TYPES, content = {} } = Astro.props;
const TYPES = items.map((type) => ({
  ...type,
  n: type.name || type.n,
  d: type.description || type.d,
  best: type.bestFor || type.best,
  src: type.imageUrl || type.src,
}));
const kicker = content.kicker || 'ADU types';
const title = content.title || 'Five ways to add a home to your lot';
const intro = content.description || 'Not sure which fits your property? We confirm setbacks, utilities and zoning in a free site visit.';
---

<section id="types" class="px-[clamp(20px,4vw,72px)] py-[clamp(88px,10vw,160px)] bg-[#F7F5F2] text-[#1C1B1A]">
  <!-- Section Header -->
  <div class="flex justify-between items-end gap-8 flex-wrap mb-[clamp(48px,6vw,88px)]">
    <div class="reveal-item">
      <div class="flex items-center gap-4 text-[12px] font-semibold tracking-[0.24em] uppercase text-[#AB0000]">
        <span class="w-14 h-[1px] bg-[#AB0000]"></span>
        <span>{kicker}</span>
      </div>
      <h2 class="mt-7 font-sans font-semibold text-[clamp(36px,4.6vw,76px)] leading-[0.98] tracking-[-0.015em] uppercase text-[#1C1B1A] max-w-[900px] text-balance">
        {title}
      </h2>
    </div>

    <div class="reveal-item max-w-[400px]">
      <p class="m-0 text-[16px] font-light leading-[1.7] text-[#55524D]">
        {intro}
      </p>
    </div>
  </div>

  <!-- Interactive Split Grid -->
  <div class="v4-types grid grid-cols-1 min-[901px]:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] gap-[clamp(32px,5vw,88px)] items-start">
    
    <!-- Left Column: Accordion Selector -->
    <div class="border-t border-[#1C1B1A]">
      {TYPES.map((t, idx) => (
        <div 
          class="type-item border-b border-[#E2DED7] py-7 cursor-pointer group"
          data-type-index={idx}
          data-type-name={t.n}
        >
          <div class="flex items-baseline gap-6">
            <span class="type-num text-[13px] font-medium text-[#8C877F] min-w-[24px] transition-colors duration-300">
              {String(idx + 1).padStart(2, '0')}
            </span>

            <div class="flex-1 min-w-0">
              <!-- Type Name Title -->
              <div class="type-name text-[clamp(24px,2.4vw,38px)] font-semibold uppercase tracking-[-0.01em] leading-[1.05] text-[#8C877F] transition-colors duration-300">
                {t.n}
              </div>

              <!-- Collapsible Content -->
              <div class="type-body grid transition-all duration-500 ease-out overflow-hidden" style={idx === 0 ? 'grid-template-rows: 1fr;' : 'grid-template-rows: 0fr;'}>
                <div class="overflow-hidden">
                  <div class="font-serif italic text-[22px] text-[#AB0000] mt-3">
                    {t.tag}
                  </div>
                  <p class="mt-3 text-[15px] font-light leading-[1.7] text-[#55524D] max-w-[520px]">
                    {t.d}
                  </p>
                  
                  <!-- Specs Grid -->
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-[22px]">
                    <div>
                      <div class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[#8C877F]">Size</div>
                      <div class="text-[14px] mt-1.5 leading-[1.4] font-normal text-[#1C1B1A]">{t.size}</div>
                    </div>
                    <div>
                      <div class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[#8C877F]">Where</div>
                      <div class="text-[14px] mt-1.5 leading-[1.4] font-normal text-[#1C1B1A]">{t.where}</div>
                    </div>
                    <div>
                      <div class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[#8C877F]">Best for</div>
                      <div class="text-[14px] mt-1.5 leading-[1.4] font-normal text-[#1C1B1A]">{t.best}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Arrow Indicator -->
            <div class="type-arrow text-[#C9C4BB] transition-all duration-400 group-hover:text-[#AB0000]">
              <svg class="w-[22px] h-[22px] transition-transform duration-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
          </div>
        </div>
      ))}

      <!-- CTA to Calculator -->
      <div class="mt-9">
        <button 
          id="type-price-btn" 
          type="button" 
          onclick="window.go('calculator')"
          class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.18em] uppercase px-[26px] py-[17px] bg-[#111111] text-white cursor-pointer transition-colors duration-300 hover:bg-[#AB0000]"
        >
          <span>Price my Detached ADU</span>
        </button>
      </div>
    </div>

    <!-- Right Column: Sticky Image Preview -->
    <div class="v4-type-img sticky top-[120px] aspect-[4/5] max-h-[calc(100vh-160px)] w-full overflow-hidden bg-[#E2DED7] shadow-lg">
      {TYPES.map((t, idx) => (
        <div 
          class={`type-image-pane absolute inset-0 transition-all duration-700 ease-in-out ${idx === 0 ? 'opacity-100 scale-100 z-10 pointer-events-auto' : 'opacity-0 scale-105 z-0 pointer-events-none'}`}
          data-img-index={idx}
        >
          <img 
            src={t.src} 
            alt={t.n} 
            class="w-full h-full object-cover object-center block"
            loading="lazy"
          />
        </div>
      ))}

      <!-- Top Badge -->
      <div id="type-badge" class="absolute left-0 top-0 z-[2] bg-[#111111] text-white px-[18px] py-3 text-[11px] font-semibold tracking-[0.2em] uppercase pointer-events-none shadow-md">
        01 / 05 · Detached ADU
      </div>
    </div>

  </div>
</section>

<!-- Types Client Controller -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const items = Array.from(document.querySelectorAll('.type-item'));
    const images = Array.from(document.querySelectorAll('.type-image-pane'));
    const badge = document.getElementById('type-badge');
    const priceBtn = document.getElementById('type-price-btn');
    let activeIdx = 0;

    function setActiveType(idx) {
      if (idx === activeIdx && items[idx].classList.contains('is-active')) return;
      activeIdx = idx;

      items.forEach((item, i) => {
        const isCurrent = i === idx;
        const num = item.querySelector('.type-num');
        const name = item.querySelector('.type-name');
        const body = item.querySelector('.type-body');
        const arrow = item.querySelector('.type-arrow svg');

        if (isCurrent) {
          item.classList.add('is-active');
          if (num) { num.style.color = '#AB0000'; }
          if (name) { name.style.color = '#1C1B1A'; }
          if (body) { body.style.gridTemplateRows = '1fr'; }
          if (arrow) {
            arrow.style.transform = 'rotate(45deg)';
            arrow.style.color = '#AB0000';
          }
        } else {
          item.classList.remove('is-active');
          if (num) { num.style.color = '#8C877F'; }
          if (name) { name.style.color = '#8C877F'; }
          if (body) { body.style.gridTemplateRows = '0fr'; }
          if (arrow) {
            arrow.style.transform = 'none';
            arrow.style.color = '#C9C4BB';
          }
        }
      });

      // Switch Images
      images.forEach((img, i) => {
        if (i === idx) {
          img.classList.remove('opacity-0', 'scale-105', 'z-0', 'pointer-events-none');
          img.classList.add('opacity-100', 'scale-100', 'z-10', 'pointer-events-auto');
        } else {
          img.classList.remove('opacity-100', 'scale-100', 'z-10', 'pointer-events-auto');
          img.classList.add('opacity-0', 'scale-105', 'z-0', 'pointer-events-none');
        }
      });

      // Update Badge and Button Text
      const typeName = items[idx]?.getAttribute('data-type-name') || '';
      if (badge) {
        badge.textContent = `${String(idx + 1).padStart(2, '0')} / 05 · ${typeName}`;
      }
      if (priceBtn) {
        priceBtn.querySelector('span').textContent = `Price my ${typeName}`;
      }
    }

    // Initialize first active
    setActiveType(0);

    items.forEach((item, idx) => {
      item.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          setActiveType(idx);
        }
      });
      item.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        setActiveType(idx);
      });
    });
  });
</script>
