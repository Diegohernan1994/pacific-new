---
import { getWebsiteSettings } from '../lib/sanity-content.js';
const settings = await getWebsiteSettings();
const aduLinks = [
  ['Detached ADU', '/adu/?type=detached'],
  ['Attached ADU', '/adu/?type=attached'],
  ['Garage Conversion', '/adu/?type=garage-conversion'],
  ['JADU', '/adu/?type=jadu'],
  ['Second-story ADU', '/adu/?type=second-story']
];
const remodelLinks = [
  ['Kitchen Remodeling', '/remodel/?s=kitchen'],
  ['Bathroom Remodeling', '/remodel/?s=bathroom'],
  ['Room Additions', '/remodel/?s=additions'],
  ['Garage Remodeling', '/remodel/?s=garage'],
  ['Outdoor & Landscaping', '/remodel/?s=outdoor'],
  ['Whole-home Remodel', '/remodel/?s=whole-home']
];
const navLinks = [
  ['Financing', '/financing/'],
  ['Projects', '/projects/'],
  ['Reviews', '/reviews/'],
  ['About', '/about/'],
  ['Contact', '/contact/']
];
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Pacific West Home Builders home">
      <img src="/assets/logo-white.png" alt="Pacific West Home Builders" />
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <div class="nav-dropdown">
        <a href="/adus/" class="nav-link">ADUs <span class="chevron" aria-hidden="true"></span></a>
        <div class="dropdown-panel">
          <a href="/adus/" class="dropdown-featured">All ADU types</a>
          {aduLinks.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </div>
      <div class="nav-dropdown">
        <a href="/remodeling/" class="nav-link">Remodeling <span class="chevron" aria-hidden="true"></span></a>
        <div class="dropdown-panel">
          <a href="/remodeling/" class="dropdown-featured">All remodeling</a>
          {remodelLinks.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </div>
      {navLinks.map(([label, href]) => <a href={href} class="nav-link">{label}</a>)}
    </nav>

    <div class="header-actions">
      <a class="phone-link" href={settings.phoneLink || 'tel:8883984499'}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.08 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.57 2.8.69A2 2 0 0 1 22 16.92Z" /></svg>
        <span>{settings.phone || '(888) 398-4499'}</span>
      </a>
      <a href="/contact/" class="visit-button">Free site visit</a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu">
          <svg class="menu-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
          <svg class="menu-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m18 6-12 12M6 6l12 12" /></svg>
        </summary>
        <nav class="mobile-panel" aria-label="Mobile navigation">
          <div class="mobile-group">
            <a class="mobile-heading" href="/adus/">ADUs</a>
            <a href="/adus/" class="mobile-featured">All ADU types</a>
            {aduLinks.map(([label, href]) => <a href={href}>{label}</a>)}
          </div>
          <div class="mobile-group">
            <a class="mobile-heading" href="/remodeling/">Remodeling</a>
            <a href="/remodeling/" class="mobile-featured">All remodeling</a>
            {remodelLinks.map(([label, href]) => <a href={href}>{label}</a>)}
          </div>
          {navLinks.map(([label, href]) => <a class="mobile-heading single-link" href={href}>{label}</a>)}
          <a class="mobile-phone" href={settings.phoneLink || 'tel:8883984499'}>{settings.phone || '(888) 398-4499'}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header{position:fixed;inset:0 0 auto;z-index:100;background:#111;border-bottom:1px solid rgba(255,255,255,.08);color:#fff}
  .header-inner{height:84px;padding:0 clamp(20px,4vw,72px);display:flex;align-items:center;gap:32px}
  .brand{display:flex;flex:none;align-items:center}
  .brand img{display:block;width:auto;height:46px;max-width:140px;object-fit:contain}
  .desktop-nav{display:flex;align-items:center;gap:clamp(18px,2.2vw,34px);margin:0 auto}
  .nav-dropdown{position:relative;display:flex;align-items:center;height:84px}
  .nav-link{display:flex;align-items:center;gap:7px;padding:8px 0;border-bottom:1px solid transparent;color:rgba(255,255,255,.78);font-size:14px;font-weight:400;white-space:nowrap;transition:color .25s,border-color .25s}
  .nav-link:hover,.nav-dropdown:focus-within>.nav-link,.nav-dropdown:hover>.nav-link{color:#fff;border-color:#AB0000}
  .chevron{width:7px;height:7px;border-right:1px solid currentColor;border-bottom:1px solid currentColor;transform:rotate(45deg) translateY(-2px)}
  .dropdown-panel{position:absolute;top:calc(100% - 2px);left:-22px;min-width:250px;padding:10px 0;background:#111;border:1px solid rgba(255,255,255,.1);opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .25s,transform .25s,visibility .25s}
  .nav-dropdown:hover .dropdown-panel,.nav-dropdown:focus-within .dropdown-panel{opacity:1;visibility:visible;transform:none}
  .dropdown-panel a{display:block;padding:11px 22px;color:#fff;font-size:14px;font-weight:300;transition:color .2s}
  .dropdown-panel a:hover{color:#ff8a8a}
  .dropdown-panel .dropdown-featured{color:#ff8a8a;font-weight:500;border-bottom:1px solid rgba(255,255,255,.08)}
  .header-actions{display:flex;align-items:center;gap:28px;margin-left:auto;flex:none}
  .phone-link{display:flex;align-items:center;gap:10px;color:#fff;font-size:14px;font-weight:500;white-space:nowrap;transition:color .2s}
  .phone-link:hover{color:rgba(255,255,255,.75)}
  .phone-link svg{width:16px;height:16px;color:#AB0000}
  .visit-button{display:inline-flex;align-items:center;justify-content:center;padding:15px 22px;background:#AB0000;color:#fff;font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;white-space:nowrap;transition:background .25s}
  .visit-button:hover{background:#8f0000;color:#fff}
  .mobile-menu{display:none;position:relative}
  .mobile-menu summary{display:grid;width:48px;height:48px;place-items:center;border:1px solid rgba(255,255,255,.25);list-style:none;cursor:pointer}
  .mobile-menu summary::-webkit-details-marker{display:none}
  .mobile-menu summary svg{width:20px;height:20px}
  .menu-close{display:none}
  .mobile-menu[open] .menu-open{display:none}
  .mobile-menu[open] .menu-close{display:block}
  .mobile-panel{position:fixed;inset:84px 0 0;overflow-y:auto;padding:24px clamp(20px,4vw,72px) 48px;background:#111;box-shadow:0 20px 30px rgba(0,0,0,.3)}
  .mobile-group{display:grid;gap:10px;padding:18px 0;border-bottom:1px solid rgba(255,255,255,.1)}
  .mobile-group>a:not(.mobile-heading){color:rgba(255,255,255,.7);font-size:15px;font-weight:300}
  .mobile-featured{color:#ff8a8a!important}
  .mobile-heading{display:block;color:#fff;font-size:18px;font-weight:600;text-transform:uppercase}
  .mobile-heading.single-link{padding:18px 0;border-bottom:1px solid rgba(255,255,255,.1)}
  .mobile-phone{display:block;margin-top:28px;color:#fff;font-size:20px}
  @media(max-width:1180px){.desktop-nav{display:none}.mobile-menu{display:block}}
  @media(max-width:760px){.phone-link{display:none}.header-actions{gap:12px}.visit-button{padding:14px 14px;font-size:10px;letter-spacing:.14em}.brand img{height:42px}}
  @media(max-width:390px){.header-inner{gap:10px}.visit-button{padding:12px 10px;font-size:9px}.brand img{height:38px}}
</style>
