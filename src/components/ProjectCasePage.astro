---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PageCTA from './PageCTA.astro';
import Contact from './Contact.astro';
import { projectQuotes } from '../data/reviews-projects.js';

const { project, previous, next, quoteIndex } = Astro.props;
const quote = projectQuotes[quoteIndex];
const facts = [
  ['Project', project.name],
  ['Location', `${project.city}, CA`],
  ['Size', project.size],
  ['Build time', project.time],
  ['Completed', project.year],
  ['Investment', project.budget]
];
const story = [
  ['01', 'The brief', project.brief],
  ['02', 'The challenge', project.challenge],
  ['03', 'Our solution', project.solution]
];
const pageTitle = `${project.name} in ${project.city} | Pacific West Home Builders`;
---

<Layout title={pageTitle} description={project.summary} canonical={`https://pwhbuilders.com/projects/${project.slug}/`} socialImage={project.cover}>
  <Header />
  <main class="project-detail">
    <section class="case-hero">
      <img src={project.cover} alt={`${project.name} project in ${project.city}`} fetchpriority="high" />
      <div class="case-overlay"></div>
      <div class="case-hero-content">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/projects/">Projects</a><span>/</span><span>{project.name}, {project.city}</span></nav>
        <p class="section-label"><span></span>Case study · {project.city}</p>
        <h1>{project.name} in {project.city}</h1>
        <p class="case-summary">{project.summary}</p>
      </div>
    </section>

    <section class="case-facts" aria-label="Project details">
      {facts.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}
    </section>

    <section class="case-story">
      <div class="story-heading">
        <p class="section-label"><span></span>Behind the build</p>
        <h2>Every project starts with a plan.</h2>
      </div>
      <div class="story-grid">
        {story.map(([number, title, text]) => (
          <article class="story-step">
            <span class="story-number">{number}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="case-gallery" aria-label={`${project.name} photo gallery`}>
      <div class="gallery-heading"><p class="section-label"><span></span>Project gallery</p><p>{project.name} · {project.city}</p></div>
      <div class="gallery-grid">
        {project.gallery.map((image, index) => (
          <figure class:list={['gallery-image', { featured: index === 0 }]}>
            <img src={image} alt={`${project.name} in ${project.city}, project photo ${index + 1}`} loading="lazy" />
          </figure>
        ))}
      </div>
      <div class="case-result"><p class="section-label"><span></span>The result</p><p>{project.result}</p></div>
    </section>

    {quote && <section class="case-review">
      <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
      <blockquote>“{quote.quote}”</blockquote>
      <div class="review-author"><span></span><strong>{quote.name}</strong><small>{quote.project} · {quote.platform}</small></div>
    </section>}

    <nav class="project-pagination" aria-label="More projects">
      <a href={`/projects/${previous.slug}/`} class="pagination-link previous">
        <img src={previous.cover} alt="" loading="lazy" />
        <span><small>← Previous project</small><strong>{previous.name}</strong><em>{previous.city}</em></span>
      </a>
      <a href={`/projects/${next.slug}/`} class="pagination-link next">
        <img src={next.cover} alt="" loading="lazy" />
        <span><small>Next project →</small><strong>{next.name}</strong><em>{next.city}</em></span>
      </a>
    </nav>
  </main>
  <PageCTA kicker="Planning something similar?" title={`Start your ${project.name.toLowerCase()}`} actionHref="/contact/" actionLabel="Book a site visit" image={project.gallery[0]} />
  <Contact
    title="Let’s discuss a project like this"
    kicker="Plan your next step"
    intro="Tell us about your property and project. Our team will help you understand the next steps."
    label="Project type"
    options={['Detached ADU', 'Attached ADU', 'Garage Conversion', 'JADU', 'Second-story ADU', 'Kitchen Remodeling', 'Bathroom Remodeling', 'Room Addition', 'Other']}
    image={project.cover}
    imageAlt={`${project.name} project in ${project.city}`}
    selectPlaceholder="Select project type"
    landing={`project-${project.slug}`}
  />
  <Footer />
</Layout>

<style>
  .project-detail{color:#1c1b1a;background:#fff}
  .case-hero{position:relative;min-height:min(820px,88vh);min-height:min(820px,88svh);display:flex;align-items:flex-end;overflow:hidden;background:#111;color:#fff}
  .case-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;animation:caseZoom 1.5s cubic-bezier(.2,.75,.2,1) both}
  .case-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.25),rgba(0,0,0,.04) 30%,rgba(0,0,0,.78)),linear-gradient(90deg,rgba(0,0,0,.5),transparent 75%)}
  .case-hero-content{position:relative;z-index:1;width:100%;padding:clamp(44px,8vh,96px) clamp(20px,4vw,72px) clamp(56px,9vh,112px);animation:caseRise .8s ease both}
  .breadcrumbs{display:flex;align-items:center;gap:10px;flex-wrap:wrap;color:rgba(255,255,255,.72);font-size:11px;letter-spacing:.15em;text-transform:uppercase}
  .breadcrumbs span:nth-child(even){color:#ff6b6b}.breadcrumbs a{color:inherit}
  .section-label{display:flex;align-items:center;gap:14px;margin:clamp(48px,8vh,84px) 0 0;color:#ff6b6b;font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase}
  .section-label span{width:48px;height:1px;background:#ab0000}
  .case-hero h1{max-width:1000px;margin:22px 0 0;font-size:clamp(44px,7vw,92px);line-height:.94;letter-spacing:-.03em;font-weight:600;text-transform:uppercase;text-wrap:balance}
  .case-summary{max-width:640px;margin:24px 0 0;color:rgba(255,255,255,.84);font-size:clamp(17px,1.5vw,21px);font-weight:300;line-height:1.6}
  .case-facts{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:24px;padding:32px clamp(20px,4vw,72px);background:#111;color:white}
  .case-facts div{display:flex;flex-direction:column;gap:9px;min-width:0}.case-facts span{color:rgba(255,255,255,.5);font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase}.case-facts strong{font-size:15px;font-weight:400;line-height:1.45}
  .case-story{padding:clamp(80px,9vw,136px) clamp(20px,4vw,72px);background:#fff}
  .story-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap;margin-bottom:clamp(40px,5vw,72px)}
  .story-heading .section-label{margin:0;color:#ab0000}.story-heading h2{max-width:560px;margin:0;font-size:clamp(34px,4vw,60px);line-height:.98;font-weight:600;letter-spacing:-.025em;text-transform:uppercase}
  .story-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .story-step{padding:28px 0 0;border-top:1px solid #1c1b1a}.story-number{color:#ab0000;font-size:13px;font-weight:600;letter-spacing:.12em}.story-step h3{margin:22px 0 0;font-size:clamp(21px,2vw,30px);font-weight:600;text-transform:uppercase}.story-step p{margin:14px 0 0;color:#68645f;font-size:16px;font-weight:300;line-height:1.75}
  .case-gallery{padding:0 clamp(20px,4vw,72px) clamp(80px,9vw,136px);background:#fff}
  .gallery-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:28px}.gallery-heading .section-label{margin:0;color:#ab0000}.gallery-heading>p{margin:0;color:#77736d;font-size:13px;letter-spacing:.08em;text-transform:uppercase}
  .gallery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:clamp(170px,18vw,300px);gap:12px}
  .gallery-image{min-width:0;min-height:0;margin:0;overflow:hidden;background:#e9e6e1}.gallery-image:first-child{grid-column:span 2;grid-row:span 2}.gallery-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .9s ease}.gallery-image:hover img{transform:scale(1.04)}
  .case-result{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);align-items:start;gap:24px clamp(32px,6vw,120px);margin-top:clamp(56px,6vw,96px)}.case-result .section-label{margin:4px 0 0;color:#ab0000}.case-result>p:last-child{margin:0;font-size:clamp(22px,2.2vw,34px);font-weight:300;line-height:1.4;letter-spacing:-.01em;text-wrap:pretty}
  .case-review{padding:clamp(76px,9vw,136px) clamp(20px,4vw,72px);background:#111;color:#fff}.case-review .stars{color:#ab0000;font-size:21px;letter-spacing:.1em}.case-review blockquote{max-width:1100px;margin:32px 0 0;font-size:clamp(25px,3vw,44px);font-weight:300;line-height:1.3;letter-spacing:-.01em;text-wrap:pretty}
  .review-author{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:36px;font-size:12px;letter-spacing:.13em;text-transform:uppercase}.review-author>span{width:40px;height:1px;background:#ab0000}.review-author strong{font-weight:600}.review-author small{color:rgba(255,255,255,.6);font-size:11px;font-weight:300}
  .project-pagination{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-bottom:1px solid #dedbd6}
  .pagination-link{display:flex;align-items:center;gap:22px;min-width:0;padding:clamp(28px,4vw,56px) clamp(20px,4vw,72px);color:#1c1b1a;transition:background .2s}.pagination-link:hover{background:#f7f5f2}.pagination-link.next{flex-direction:row-reverse;text-align:right;border-left:1px solid #dedbd6}.pagination-link img{width:clamp(76px,9vw,140px);aspect-ratio:1;flex:none;object-fit:cover}.pagination-link span{display:flex;min-width:0;flex-direction:column;gap:8px}.pagination-link small{color:#68645f;font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}.pagination-link strong{font-size:clamp(17px,1.6vw,24px);font-weight:600;text-transform:uppercase}.pagination-link em{color:#68645f;font-size:13px;font-style:normal;font-weight:300}
  @keyframes caseRise{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}@keyframes caseZoom{from{transform:scale(1.06)}to{transform:scale(1)}}
  @media(max-width:1050px){.case-facts{grid-template-columns:repeat(3,minmax(0,1fr))}.gallery-grid{grid-auto-rows:clamp(160px,23vw,250px)}}
  @media(max-width:760px){.case-hero{min-height:78svh}.case-hero-content{padding:38px 20px 54px}.section-label{margin-top:48px}.case-hero h1{font-size:clamp(38px,11vw,60px)}.case-facts{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 16px;padding:28px 20px}.story-grid{grid-template-columns:minmax(0,1fr);gap:30px}.story-step{padding-top:20px}.story-step h3{margin-top:14px}.story-step p{margin-top:10px}.gallery-heading{align-items:flex-start;flex-direction:column}.gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:auto;grid-auto-flow:dense;gap:10px}.gallery-image{aspect-ratio:1}.gallery-image:first-child{grid-column:auto;grid-row:auto}.gallery-image img{aspect-ratio:1}.gallery-image:last-child:nth-child(odd){grid-column:1/-1;aspect-ratio:16/9}.gallery-image:last-child:nth-child(odd) img{aspect-ratio:16/9}.case-result{grid-template-columns:minmax(0,1fr);gap:20px}.project-pagination{grid-template-columns:minmax(0,1fr)}.pagination-link{padding:24px 20px}.pagination-link.next{border-left:0;border-top:1px solid #dedbd6}.pagination-link img{width:76px}.pagination-link strong{font-size:16px}}
  @media(prefers-reduced-motion:reduce){.project-detail *{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
</style>
