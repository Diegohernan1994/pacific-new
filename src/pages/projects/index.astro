---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageCTA from '../../components/PageCTA.astro';
import Contact from '../../components/Contact.astro';
import { getPortfolioContent } from '../../lib/sanity-content.js';

const { projects } = await getPortfolioContent();

const categories = ['All', 'ADUs', 'Remodels'];
const countFor = (category) => category === 'All' ? projects.length : projects.filter((project) => project.category === category).length;
---

<Layout
  title="Projects | Pacific West Home Builders"
  description="Explore ADU and remodeling projects by Pacific West Home Builders across Southern California. See the brief, challenge, and solution behind each build."
  canonical="https://pwhbuilders.com/projects/"
>
  <Header />
  <main class="projects-page">
    <section class="projects-hero">
      <div class="eyebrow"><a href="/">Home</a><span>/</span><span>Projects</span></div>
      <p class="section-label"><span></span>Our work</p>
      <h1>Projects</h1>
      <p class="hero-lead">ADUs and remodels across Southern California. Each project has its own page with the brief, the challenge and how we solved it.</p>
      <div class="project-filters" role="group" aria-label="Filter projects">
        {categories.map((category, index) => (
          <button type="button" class:list={['filter-button', { active: index === 0 }]} data-project-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>
            {category}<span>{countFor(category)}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="project-grid" aria-label="Project portfolio">
      {projects.map((project, index) => (
        <a class="project-card" data-project-card data-category={project.category} href={`/projects/${project.slug}/`}>
          <div class="project-image">
            <img src={project.cover} alt={`${project.name} in ${project.city}`} loading={index < 2 ? 'eager' : 'lazy'} />
            <span>{project.category === 'ADUs' ? 'ADU' : 'Remodel'}</span>
          </div>
          <div class="project-location"><span>{project.city}</span><span>{project.year}</span></div>
          <div class="project-title-row">
            <div>
              <h2>{project.name}</h2>
              <p>{project.summary}</p>
            </div>
            <span class="project-arrow" aria-hidden="true">↗</span>
          </div>
          <div class="project-facts"><span>{project.size.split(' · ')[0]}</span><span>{project.time}</span></div>
        </a>
      ))}
      <p class="no-projects" hidden>No projects found in this category.</p>
    </section>
  </main>
  <PageCTA kicker="Your project next" title="Start with a free site visit" actionHref="/contact/" actionLabel="Book a site visit" image="/assets/imagery/reviews-projects/build/08-completed.jpg" />
  <Contact
    title="Let’s plan your project"
    kicker="Start a conversation"
    intro="Tell us what you have in mind. Our team can help you plan the next step for your home."
    label="Project type"
    options={['Detached ADU', 'Attached ADU', 'Garage Conversion', 'JADU', 'Second-story ADU', 'Kitchen Remodeling', 'Bathroom Remodeling', 'Room Addition', 'Other']}
    selectPlaceholder="Select project type"
    image="/assets/imagery/reviews-projects/build/08-completed.jpg"
    imageAlt="Completed Pacific West Home Builders project"
    landing="projects-page"
  />
  <Footer />
</Layout>

<script>
  const filterButtons = Array.from(document.querySelectorAll('[data-project-filter]'));
  const projectCards = Array.from(document.querySelectorAll('[data-project-card]'));
  const emptyState = document.querySelector('.no-projects');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.projectFilter;
      let visible = 0;
      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      projectCards.forEach((card) => {
        const show = selected === 'All' || card.dataset.category === selected;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (emptyState) emptyState.hidden = visible > 0;
    });
  });
</script>

<style>
  .projects-page{background:#111;color:#fff}
  .projects-hero{padding:calc(84px + clamp(52px,7vw,104px)) clamp(20px,4vw,72px) clamp(40px,5vw,64px);background:#111}
  .eyebrow{display:flex;gap:10px;align-items:center;color:rgba(255,255,255,.55);font-size:11px;letter-spacing:.16em;text-transform:uppercase}
  .eyebrow a{color:inherit}.eyebrow span:nth-child(2){color:#ab0000}
  .section-label{display:flex;align-items:center;gap:14px;margin:40px 0 0;color:#ff6b6b;font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase}
  .section-label span{width:48px;height:1px;background:#ab0000}
  .projects-hero h1{margin:24px 0 0;font-size:clamp(54px,8vw,104px);line-height:.92;letter-spacing:-.035em;font-weight:600;text-transform:uppercase;animation:projectsRise .8s ease both}
  .hero-lead{max-width:620px;margin:24px 0 0;color:rgba(255,255,255,.76);font-size:clamp(16px,1.4vw,19px);font-weight:300;line-height:1.65}
  .project-filters{display:flex;flex-wrap:wrap;gap:8px;margin-top:clamp(36px,5vw,52px)}
  .filter-button{display:inline-flex;align-items:center;gap:10px;padding:12px 16px;border:1px solid rgba(255,255,255,.24);background:transparent;color:rgba(255,255,255,.78);font-family:inherit;font-size:12px;font-weight:500;letter-spacing:.06em;cursor:pointer;transition:background .2s,color .2s,border .2s}
  .filter-button span{opacity:.55}.filter-button:hover,.filter-button.active{border-color:#ab0000;background:#ab0000;color:#fff}
  .project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:48px 16px;padding:clamp(24px,3vw,40px) clamp(20px,4vw,72px) clamp(88px,10vw,160px);background:#111}
  .project-card{display:block;min-width:0;color:#fff;animation:projectsRise .7s ease both}.project-card[hidden]{display:none}
  .project-image{position:relative;aspect-ratio:4/3;overflow:hidden;background:#222}.project-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform 1s cubic-bezier(.2,.75,.2,1)}
  .project-card:hover .project-image img{transform:scale(1.045)}.project-image>span{position:absolute;top:0;left:0;padding:8px 12px;background:#ab0000;color:#fff;font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
  .project-location{display:flex;gap:14px;margin-top:20px;color:#ff8a8a;font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase}.project-location span+span{color:rgba(255,255,255,.5)}
  .project-title-row{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-top:10px}.project-title-row h2{margin:0;font-size:22px;font-weight:600;line-height:1.15;text-transform:uppercase}.project-title-row p{margin:8px 0 0;color:rgba(255,255,255,.72);font-size:14px;font-weight:300;line-height:1.55}.project-arrow{flex:none;font-size:22px;transition:transform .25s}.project-card:hover .project-arrow{transform:translate(3px,-3px);color:#ff8a8a}
  .project-facts{display:flex;gap:20px;margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,.14);color:rgba(255,255,255,.75);font-size:13px;font-weight:300}
  .no-projects{grid-column:1/-1;margin:0;color:rgba(255,255,255,.72)}
  @keyframes projectsRise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
  @media(max-width:1024px){.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.projects-hero{padding-top:calc(84px + 38px)}.projects-hero h1{font-size:clamp(48px,13vw,72px)}.project-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 10px;padding:24px 20px 80px}.project-image{aspect-ratio:1}.project-title-row h2{font-size:16px}.project-title-row p{font-size:12px;line-height:1.5}.project-title-row{gap:8px}.project-arrow{font-size:18px}.project-facts{gap:10px;font-size:11px}.project-card:last-of-type:nth-of-type(odd){grid-column:1/-1}.project-card:last-of-type:nth-of-type(odd) .project-image{aspect-ratio:16/9}}
  @media(prefers-reduced-motion:reduce){.projects-page *{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
</style>
