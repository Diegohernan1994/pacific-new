---
import Layout from '../layouts/Layout.astro';
import Header from '../components/v3/Header.astro';
import BuildHero from '../components/v3/BuildHero.astro';
import Types from '../components/v3/Types.astro';
import Process from '../components/v3/Process.astro';
import Gallery from '../components/v3/Gallery.astro';
import Calculator from '../components/v3/Calculator.astro';
import OtherServices from '../components/v3/OtherServices.astro';
import Reviews from '../components/v3/Reviews.astro';
import Faq from '../components/v3/Faq.astro';
import Contact from '../components/v3/Contact.astro';
import Footer from '../components/v3/Footer.astro';
import AskUs from '../components/v3/AskUs.astro';
---

<Layout 
  title="Pacific West Home Builders · ADUs (v3)"
  description="Pacific West designs, permits and builds accessory dwelling units across Southern California. Custom detached ADUs, garage conversions, and additions."
>
  <Header />
  
  <main class="w-full">
    <BuildHero />
    <Types />
    <Process />
    <Gallery />
    <Calculator />
    <OtherServices />
    <Reviews />
    <Faq />
    <Contact />
  </main>

  <Footer />
  <AskUs />
</Layout>
