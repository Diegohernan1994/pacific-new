<!-- Client Interactivity for Hero Cursor, Benefits Accordion, Process Scrubber & 44-Photo Lightbox -->
<script is:inline define:vars={{ ALL_GAL_SRCS }}>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Hero Circle Follower Logic (Clean version with click-through protection)
    const heroSection = document.getElementById('top');
    const crosshairBox = document.getElementById('crosshair-box');
    const crosshairCircle = document.getElementById('crosshair-circle');

    function setCrosshairPosition(x, y) {
      if (!crosshairBox || !crosshairCircle) return;
      crosshairBox.style.opacity = '1';
      crosshairCircle.style.transform = `translate(${x - 20}px, ${y - 20}px)`;
    }

    if (heroSection && crosshairBox) {
      const rInit = heroSection.getBoundingClientRect();
      setCrosshairPosition(
        Math.round((rInit.width || window.innerWidth) * 0.56),
        Math.round((rInit.height || window.innerHeight) * 0.52)
      );

      if (!window.matchMedia('(hover: none)').matches) {
        heroSection.addEventListener('mousemove', (e) => {
          const r = heroSection.getBoundingClientRect();
          setCrosshairPosition(e.clientX - r.left, e.clientY - r.top);
        });

        const interactiveEls = heroSection.querySelectorAll('button, a, #scroll-prompt');
        interactiveEls.forEach((el) => {
          el.addEventListener('mouseenter', () => {
            crosshairBox.style.opacity = '0';
          });
          el.addEventListener('mouseleave', () => {
            crosshairBox.style.opacity = '1';
          });
        });
      }
    }

    // 2. Key Benefits Interactive Split Accordion
    const items = Array.from(document.querySelectorAll('.type-item'));
    const images = Array.from(document.querySelectorAll('.type-image-pane'));
    const badge = document.getElementById('type-badge');
    let activeIdx = 0;

    function setActiveBenefit(idx) {
      if (idx === activeIdx && items[idx]?.classList.contains('is-active')) return;
      activeIdx = idx;

      items.forEach((item, i) => {
        const isCurrent = i === idx;
        const num = item.querySelector('.type-num');
        const name = item.querySelector('.type-name');
        const body = item.querySelector('.type-body');
        const arrow = item.querySelector('.type-arrow svg');

        if (isCurrent) {
          item.classList.add('is-active');
          if (num) num.style.color = '#AB0000';
          if (name) name.style.color = '#1C1B1A';
          if (body) body.style.gridTemplateRows = '1fr';
          if (arrow) {
            arrow.style.transform = 'rotate(45deg)';
            arrow.style.color = '#AB0000';
          }
        } else {
          item.classList.remove('is-active');
          if (num) num.style.color = '#8C877F';
          if (name) name.style.color = '#8C877F';
          if (body) body.style.gridTemplateRows = '0fr';
          if (arrow) {
            arrow.style.transform = 'none';
            arrow.style.color = '#C9C4BB';
          }
        }
      });

      images.forEach((img, i) => {
        if (i === idx) {
          img.classList.remove('opacity-0', 'scale-105', 'z-0', 'pointer-events-none');
          img.classList.add('opacity-100', 'scale-100', 'z-10', 'pointer-events-auto');
        } else {
          img.classList.remove('opacity-100', 'scale-100', 'z-10', 'pointer-events-auto');
          img.classList.add('opacity-0', 'scale-105', 'z-0', 'pointer-events-none');
        }
      });

      const benefitName = items[idx]?.getAttribute('data-type-name') || '';
      if (badge) {
        badge.textContent = `${String(idx + 1).padStart(2, '0')} / 04 · ${benefitName}`;
      }
    }

    if (items.length > 0) {
      setActiveBenefit(0);
      items.forEach((item, idx) => {
        item.addEventListener('mouseenter', () => {
          if (window.matchMedia('(hover: hover)').matches) {
            setActiveBenefit(idx);
          }
        });
        item.addEventListener('click', (e) => {
          e.preventDefault();
          setActiveBenefit(idx);
        });
      });
    }

    // 3. Process 6-Step Scroll Progress Timeline
    const processSection = document.querySelector('.process-section');
    const fillH = document.getElementById('process-progress-fill-h');
    const fillV = document.getElementById('process-progress-fill-v');
    const stepItems = Array.from(document.querySelectorAll('.process-step-item'));
    const totalSteps = stepItems.length;

    function updateProcess() {
      if (!processSection) return;
      const r = processSection.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.85 - r.top) / (r.height + window.innerHeight * 0.2)));

      if (fillH) fillH.style.transform = `scaleX(${p})`;
      if (fillV) fillV.style.transform = `scaleY(${p})`;

      stepItems.forEach((item, idx) => {
        const threshold = (idx + 0.35) / totalSteps;
        const isOn = p >= threshold;
        const node = item.querySelector('.step-node');
        const num = item.querySelector('.step-num');

        if (isOn) {
          if (node) {
            node.style.background = '#AB0000';
            node.style.borderColor = '#AB0000';
            node.style.boxShadow = '0 0 10px rgba(171, 0, 0, 0.6)';
          }
          if (num) num.style.color = '#ff6b6b';
        } else {
          if (node) {
            node.style.background = '#111111';
            node.style.borderColor = 'rgba(255, 255, 255, 0.4)';
            node.style.boxShadow = 'none';
          }
          if (num) num.style.color = 'rgba(255, 255, 255, 0.5)';
        }
      });
    }

    window.addEventListener('scroll', updateProcess, { passive: true });
    window.addEventListener('resize', updateProcess);
    updateProcess();

    // 4. Expandable 44-Photo Gallery & Fullscreen Lightbox
    const toggleBtn = document.getElementById('toggle-gallery-btn');
    const toggleText = document.getElementById('toggle-gallery-text');
    const toggleIcon = document.getElementById('toggle-gallery-icon');
    const extraGrid = document.getElementById('extra-gallery-grid');
    let isExpanded = false;

    if (toggleBtn && extraGrid) {
      toggleBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;
        if (isExpanded) {
          extraGrid.classList.remove('hidden');
          extraGrid.classList.add('grid');
          if (toggleText) toggleText.textContent = 'Show Less Photos';
          if (toggleIcon) toggleIcon.style.transform = 'rotate(180deg)';
        } else {
          extraGrid.classList.remove('grid');
          extraGrid.classList.add('hidden');
          if (toggleText) toggleText.textContent = 'View All 44 Kitchen Photos';
          if (toggleIcon) toggleIcon.style.transform = 'none';
          window.go('projects');
        }
      });
    }

    const lightbox = document.getElementById('kitchen-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const btnClose = document.getElementById('lightbox-close');
    const btnPrev = document.getElementById('lightbox-prev');
    const btnNext = document.getElementById('lightbox-next');
    let currentGalIdx = 0;

    function openLightbox(idx) {
      if (!lightbox || !lightboxImg) return;
      currentGalIdx = (idx + ALL_GAL_SRCS.length) % ALL_GAL_SRCS.length;
      lightboxImg.src = ALL_GAL_SRCS[currentGalIdx];
      if (lightboxCounter) {
        lightboxCounter.textContent = `${String(currentGalIdx + 1).padStart(2, '0')} / ${ALL_GAL_SRCS.length}`;
      }
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('flex');
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.gallery-trigger').forEach((el) => {
      el.addEventListener('click', () => {
        const idx = parseInt(el.getAttribute('data-gal-index') || '0', 10);
        openLightbox(idx);
      });
    });

    if (btnClose) btnClose.addEventListener('click', closeLightbox);
    if (btnPrev) btnPrev.addEventListener('click', () => openLightbox(currentGalIdx - 1));
    if (btnNext) btnNext.addEventListener('click', () => openLightbox(currentGalIdx + 1));

    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
    }

    window.addEventListener('keydown', (e) => {
      if (!lightbox || lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') openLightbox(currentGalIdx - 1);
      if (e.key === 'ArrowRight') openLightbox(currentGalIdx + 1);
    });
  });
</script>

<style>
  #crosshair-box,
  #crosshair-box * {
    pointer-events: none !important;
  }
  #scroll-prompt {
    pointer-events: auto !important;
    cursor: pointer !important;
  }
</style>
