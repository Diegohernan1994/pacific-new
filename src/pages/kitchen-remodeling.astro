---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const BENEFITS = [
  {
    n: 'A Kitchen Tailored to Your Life',
    d: 'Your kitchen should complement your daily routine and family’s needs. Whether it’s optimizing the layout for better flow or choosing materials that reflect your unique style, we create kitchens that fit your life seamlessly.'
  },
  {
    n: 'Enhanced Functionality and Efficiency',
    d: 'Say goodbye to cramped, outdated spaces. A remodel lets you reconfigure your kitchen for better organization, more storage, and upgraded appliances, ensuring every inch works for you.'
  },
  {
    n: 'Boost Your Home’s Value',
    d: 'A beautifully remodeled kitchen is one of the best investments you can make. Not only does it enhance your everyday life, but it also significantly increases your home’s market appeal and resale value.'
  },
  {
    n: 'A Space That Reflects You',
    d: 'From sleek, modern designs to warm, traditional aesthetics, your remodeled kitchen will be a true reflection of your taste and personality, customized down to the finest detail.'
  }
];

const PROCESS_STEPS = [
  {
    title: 'Consultation and Vision',
    desc: 'We start by understanding your needs, lifestyle, and vision for your new kitchen. Together, we assess your current space and craft a personalized plan that reflects your goals and style.'
  },
  {
    title: 'Detailed Design and Planning',
    desc: 'Our design team creates a customized layout, helping you choose the perfect materials, finishes, and features to bring your vision to life while optimizing functionality.'
  },
  {
    title: '3D Design and Visualization',
    desc: 'See your dream kitchen come to life before construction even begins. Our 3D design renderings provide a realistic preview of your remodeled kitchen, allowing you to finetune every detail and make confident decisions.'
  },
  {
    title: 'Demolition and Preparation',
    desc: 'Our skilled team carefully removes outdated elements, prepares the space for installation, and ensures minimal disruption to your home during this phase.'
  },
  {
    title: 'Construction and Installation',
    desc: 'From structural adjustments to installing cabinets, countertops, lighting, and plumbing, we handle every detail with precision and expert craftsmanship.'
  },
  {
    title: 'Final Touches and Walkthrough',
    desc: 'We complete your space with finishing touches, like backsplashes, hardware, and decorative elements. Finally, a detailed walkthrough ensures your complete satisfaction and ensures every element is exactly as you envisioned.'
  }
];

const WHY_CHOOSE = [
  {
    title: 'Tailored Solutions',
    desc: 'Every kitchen remodel is designed to reflect your unique needs, lifestyle, and personal taste.',
    icon: '/assets/imagery/kitchen/diamond-1.png'
  },
  {
    title: 'Exceptional Quality at Any Budget',
    desc: 'We balance affordability with high-quality materials and craftsmanship to create stunning results without exceeding your budget.',
    icon: '/assets/imagery/kitchen/diamond-1.png'
  },
  {
    title: 'Seamless Communication',
    desc: 'From start to finish, we keep you informed, ensuring every step of the process is smooth and stress-free.',
    icon: '/assets/imagery/kitchen/business-ethics.png'
  },
  {
    title: 'Commitment to Your Vision',
    desc: 'Your satisfaction is our priority. We don’t consider the job done until you’re thrilled with your new kitchen.',
    icon: '/assets/imagery/kitchen/business-ethics.png'
  }
];

const ALL_GAL_SRCS = [
  '/assets/imagery/kitchen/gallery/gal-01.jpg',
  '/assets/imagery/kitchen/gallery/gal-02.jpg',
  '/assets/imagery/kitchen/gallery/gal-03.jpg',
  '/assets/imagery/kitchen/gallery/gal-04.jpg',
  '/assets/imagery/kitchen/gallery/gal-05.jpg',
  '/assets/imagery/kitchen/gallery/gal-06.jpg',
  '/assets/imagery/kitchen/gallery/gal-07.jpg',
  '/assets/imagery/kitchen/gallery/gal-08.jpg',
  '/assets/imagery/kitchen/gallery/gal-09.jpg',
  '/assets/imagery/kitchen/gallery/gal-10.jpg',
  '/assets/imagery/kitchen/gallery/gal-11.jpg',
  '/assets/imagery/kitchen/gallery/gal-12.jpg',
  '/assets/imagery/kitchen/gallery/gal-13.jpg',
  '/assets/imagery/kitchen/gallery/gal-14.png',
  '/assets/imagery/kitchen/gallery/gal-15.png',
  '/assets/imagery/kitchen/gallery/gal-16.png',
  '/assets/imagery/kitchen/gallery/gal-17.png',
  '/assets/imagery/kitchen/gallery/gal-18.jpg',
  '/assets/imagery/kitchen/gallery/gal-19.jpg',
  '/assets/imagery/kitchen/gallery/gal-20.png',
  '/assets/imagery/kitchen/gallery/gal-21.png',
  '/assets/imagery/kitchen/gallery/gal-22.png',
  '/assets/imagery/kitchen/gallery/gal-23.png',
  '/assets/imagery/kitchen/gallery/gal-24.png',
  '/assets/imagery/kitchen/gallery/gal-25.png',
  '/assets/imagery/kitchen/gallery/gal-26.png',
  '/assets/imagery/kitchen/gallery/gal-27.png',
  '/assets/imagery/kitchen/gallery/gal-28.png',
  '/assets/imagery/kitchen/gallery/gal-29.png',
  '/assets/imagery/kitchen/gallery/gal-30.png',
  '/assets/imagery/kitchen/gallery/gal-31.png',
  '/assets/imagery/kitchen/gallery/gal-32.png',
  '/assets/imagery/kitchen/gallery/gal-33.png',
  '/assets/imagery/kitchen/gallery/gal-34.png',
  '/assets/imagery/kitchen/gallery/gal-35.png',
  '/assets/imagery/kitchen/gallery/gal-36.png',
  '/assets/imagery/kitchen/gallery/gal-37.png',
  '/assets/imagery/kitchen/gallery/gal-38.png',
  '/assets/imagery/kitchen/gallery/gal-39.png',
  '/assets/imagery/kitchen/gallery/gal-40.png',
  '/assets/imagery/kitchen/gallery/gal-41.png',
  '/assets/imagery/kitchen/gallery/gal-42.png',
  '/assets/imagery/kitchen/gallery/gal-43.png',
  '/assets/imagery/kitchen/gallery/gal-44.png'
];
---

<Layout 
  title="Kitchen Remodeling - Pacific West Home Builders"
  description="Transform Your Kitchen with Pacific West Home Builders. Your Dream Kitchen, Designed Just for You."
>
  <Header />

  <main class="w-full">
    
    <!-- =====================================================================
         SECTION 1: HERO (banner.webp)
         ===================================================================== -->
    <section id="top" class="relative h-screen min-h-[640px] w-full overflow-hidden bg-[#111111] text-white select-none">
      <!-- Background Image Layer (z-index: 1) -->
      <div class="absolute inset-0 pt-[84px] z-[1]">
        <div class="w-full h-full overflow-hidden">
          <img 
            src="/assets/imagery/kitchen/banner.webp" 
            alt="Transform Your Kitchen with Pacific West Home Builders" 
            class="w-full h-full object-cover object-center block"
            loading="eager"
          />
        </div>
      </div>

      <!-- Architectural Gradient Vignette Layer (z-index: 2) -->
      <div 
        class="absolute inset-0 z-[2] pointer-events-none"
        style="background: linear-gradient(180deg, rgba(0,0,0,0.15) 25%, rgba(0,0,0,0.78) 100%), linear-gradient(90deg, rgba(0,0,0,0.55), rgba(0,0,0,0) 65%);"
      ></div>

      <!-- Architectural Circle Follower Layer (z-index: 3) -->
      <div id="crosshair-box" aria-hidden="true" class="absolute inset-0 pointer-events-none transition-opacity duration-300 z-[3]" style="opacity: 1; pointer-events: none !important;">
        <div id="crosshair-circle" class="absolute left-0 top-0 w-10 h-10 rounded-full border border-[#AB0000] grid place-items-center will-change-transform pointer-events-none" style="pointer-events: none !important;">
          <span class="w-1 h-1 rounded-full bg-[#AB0000] pointer-events-none" style="pointer-events: none !important;"></span>
        </div>
      </div>

      <!-- Hero Content (z-index: 4) -->
      <div class="absolute z-[4] left-[clamp(20px,4vw,72px)] right-[clamp(20px,4vw,72px)] bottom-[clamp(64px,11vh,128px)] max-w-[1040px] pointer-events-none">
        <div class="flex items-center gap-4 flex-wrap text-[12px] font-semibold tracking-[0.24em] uppercase text-[#ff6b6b]" style="animation: v4Rise 0.8s var(--ease-out) both;">
          <span class="w-14 h-[1px] bg-[#ff6b6b]"></span>
          <span>Kitchen Remodeling</span>
          <span class="text-white/40">·</span>
          <span class="text-white/85">Pacific West Home Builders</span>
        </div>

        <h1 class="mt-6 font-sans font-semibold text-[clamp(36px,5.2vw,92px)] leading-[0.95] tracking-[-0.02em] uppercase text-balance text-white" style="animation: v4Rise 0.9s var(--ease-out) 80ms both;">
          Transform Your Kitchen with Pacific West Home Builders
        </h1>

        <div class="flex gap-3 flex-wrap mt-[34px] pointer-events-auto" style="animation: v4Rise 0.9s var(--ease-out) 180ms both;">
          <a 
            href="#contact" 
            onclick="event.preventDefault(); window.go('contact');"
            class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.18em] uppercase px-[28px] py-[18px] bg-[#AB0000] text-white cursor-pointer transition-colors duration-300 hover:bg-[#8F0000]"
          >
            <span>CONTACT US NOW</span>
          </a>
        </div>
      </div>

      <!-- Bottom Accent Line -->
      <div class="absolute z-[4] left-0 right-0 bottom-0 h-1 bg-white/10">
        <div class="h-full w-full bg-[#AB0000]"></div>
      </div>
    </section>

    <!-- =====================================================================
         SECTION 2: YOUR DREAM KITCHEN, DESIGNED JUST FOR YOU (dream-kitchen.jpg)
         ===================================================================== -->
    <section id="dream-kitchen" class="px-[clamp(20px,4vw,72px)] py-[clamp(88px,10vw,160px)] bg-[#F7F5F2] text-[#1C1B1A]">
      <div class="grid grid-cols-1 min-[901px]:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] gap-[clamp(36px,6vw,96px)] items-center">
        
        <!-- Left Column -->
        <div class="reveal-item">
          <span class="block w-14 h-[1px] bg-[#AB0000] mb-7"></span>

          <h2 class="font-sans font-semibold text-[clamp(34px,4.4vw,68px)] leading-[0.98] tracking-[-0.015em] uppercase text-[#1C1B1A] text-balance">
            Your Dream Kitchen, Designed Just for You
          </h2>

          <div class="mt-8 space-y-6 text-[16px] sm:text-[17px] font-light leading-[1.75] text-[#55524D] max-w-[640px]">
            <p class="m-0">
              The kitchen is the heart of the home—a space where family and friends gather, where creativity comes alive, and where lasting memories are made. At Pacific West Home Builders, we believe everyone deserves a kitchen that fits their style, meets their needs, and stays within their budget. we specialize in transforming outdated kitchens into functional, beautiful, and inviting spaces that elevate your home’s style and functionality.
            </p>
            <p class="m-0">
              Whether you’re envisioning a modern space with sleek finishes or a cozy, timeless kitchen, we are here to bring your dream to life. With a focus on personalized solutions, unmatched professionalism, and thoughtful planning, we transform kitchens into spaces you’ll love for years to come.
            </p>
          </div>
        </div>

        <!-- Right Column: dream-kitchen.jpg -->
        <div class="reveal-item relative aspect-[4/3] sm:aspect-[5/4] w-full overflow-hidden bg-[#E2DED7] shadow-xl group">
          <img 
            src="/assets/imagery/kitchen/dream-kitchen.jpg" 
            alt="Your Dream Kitchen, Designed Just for You" 
            class="w-full h-full object-cover object-center block transition-transform duration-[1400ms] ease-out group-hover:scale-105"
            loading="lazy"
          />
        </div>

      </div>
    </section>

    <!-- =====================================================================
         SECTION 3: WHAT WE BRING TO YOUR KITCHEN REMODEL (what-we-bring-bg.webp)
         ===================================================================== -->
    <section id="what-we-bring" class="relative px-[clamp(20px,4vw,72px)] py-[clamp(96px,11vw,176px)] bg-[#111111] text-white overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/imagery/kitchen/what-we-bring-bg.webp" 
          alt="What We Bring to Your Kitchen Remodel" 
          class="w-full h-full object-cover object-center block opacity-35"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#111111] via-[#111111]/85 to-[#111111]/65"></div>
      </div>

      <div class="relative z-10 max-w-[960px] reveal-item">
        <span class="block w-14 h-[1px] bg-[#ff6b6b] mb-7"></span>

        <h2 class="font-sans font-semibold text-[clamp(34px,4.6vw,72px)] leading-[0.98] tracking-[-0.015em] uppercase text-white text-balance">
          What We Bring to Your Kitchen Remodel
        </h2>

        <p class="mt-8 text-[clamp(16px,1.35vw,21px)] font-light leading-[1.75] text-white/90 max-w-[860px] m-0">
          We design kitchens that maximize space and functionality, creating a seamless flow for cooking, entertaining, and dining. Custom storage solutions, such as soft-close drawers, pull-out shelves, and built-in organizers, keep everything organized and clutter-free. High-quality finishes, including quartz or granite countertops and tile, glass, or stone backsplashes, add durability and style. Stylish and durable flooring options, such as hardwood, tile, or luxury vinyl, combined with layered lighting solutions like task lighting and decorative pendants, create the perfect ambiance.
        </p>
      </div>
    </section>

    <!-- =====================================================================
         SECTION 4: WHY REMODEL & KEY BENEFITS (key-benefits.jpg)
         ===================================================================== -->
    <section id="types" class="px-[clamp(20px,4vw,72px)] py-[clamp(88px,10vw,160px)] bg-[#F7F5F2] text-[#1C1B1A]">
      <!-- Section Header -->
      <div class="flex justify-between items-end gap-8 flex-wrap mb-[clamp(48px,6vw,88px)]">
        <div class="reveal-item max-w-[780px]">
          <span class="block w-14 h-[1px] bg-[#AB0000] mb-7"></span>
          <h2 class="font-sans font-semibold text-[clamp(34px,4.4vw,68px)] leading-[0.98] tracking-[-0.015em] uppercase text-[#1C1B1A] text-balance">
            Why Remodel Your Kitchen with Pacific West Home Builders?
          </h2>
        </div>

        <div class="reveal-item max-w-[460px]">
          <p class="m-0 text-[16px] font-light leading-[1.7] text-[#55524D]">
            A kitchen remodel is more than just an upgrade—it’s an opportunity to transform your space into the heart of your home. At Pacific West Home Builders, we specialize in designing kitchens that are tailored to your lifestyle, budget, and personal style, delivering spaces that are as functional as they are beautiful.
          </p>
        </div>
      </div>

      <!-- Interactive Split Grid -->
      <div class="v4-types grid grid-cols-1 min-[901px]:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] gap-[clamp(32px,5vw,88px)] items-start">
        
        <!-- Left Column: Subheading + 4 Benefits Accordion -->
        <div>
          <h3 class="font-sans text-[14px] font-semibold tracking-[0.2em] uppercase text-[#AB0000] mb-5">
            Key Benefits of Remodeling Your Kitchen
          </h3>

          <div class="border-t border-[#1C1B1A]">
            {BENEFITS.map((b, idx) => (
              <div 
                class="type-item border-b border-[#E2DED7] py-7 cursor-pointer group"
                data-type-index={idx}
              >
                <div class="flex items-baseline gap-6">
                  <span class="type-num text-[13px] font-medium text-[#8C877F] min-w-[24px] transition-colors duration-300">
                    {String(idx + 1).padStart(2, '0')}
                  </span>

                  <div class="flex-1 min-w-0">
                    <div class="type-name text-[clamp(22px,2.2vw,34px)] font-semibold uppercase tracking-[-0.01em] leading-[1.08] text-[#8C877F] transition-colors duration-300">
                      {b.n}
                    </div>

                    <div class="type-body grid transition-all duration-500 ease-out overflow-hidden" style={idx === 0 ? 'grid-template-rows: 1fr;' : 'grid-template-rows: 0fr;'}>
                      <div class="overflow-hidden">
                        <p class="mt-4 text-[15px] sm:text-[16px] font-light leading-[1.7] text-[#55524D] max-w-[540px] m-0">
                          {b.d}
                        </p>
                      </div>
                    </div>
                  </div>

                  <div class="type-arrow text-[#C9C4BB] transition-all duration-400 group-hover:text-[#AB0000]">
                    <svg class="w-[22px] h-[22px] transition-transform duration-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right Column: Original Image (key-benefits.jpg) -->
        <div class="v4-type-img sticky top-[120px] aspect-[4/5] max-h-[calc(100vh-160px)] w-full overflow-hidden bg-[#E2DED7] shadow-lg">
          <img 
            src="/assets/imagery/kitchen/key-benefits.jpg" 
            alt="Key Benefits of Remodeling Your Kitchen" 
            class="w-full h-full object-cover object-center block"
            loading="lazy"
          />
        </div>

      </div>
    </section>

    <!-- =====================================================================
         SECTION 5: OUR PROVEN KITCHEN REMODELING PROCESS (process-bg.webp)
         ===================================================================== -->
    <section id="process" class="process-section relative px-[clamp(20px,4vw,72px)] py-[clamp(88px,10vw,160px)] bg-[#111111] text-white overflow-hidden">
      <div class="absolute inset-0 z-0 pointer-events-none">
        <img 
          src="/assets/imagery/kitchen/process-bg.webp" 
          alt="Our Proven Kitchen Remodeling Process" 
          class="w-full h-full object-cover object-center block opacity-20"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#111111]/95 via-[#111111]/85 to-[#111111]/95"></div>
      </div>

      <div class="relative z-10 flex justify-between items-end gap-8 flex-wrap">
        <div class="reveal-item max-w-[820px]">
          <span class="block w-14 h-[1px] bg-[#ff6b6b] mb-7"></span>
          <h2 class="font-sans font-semibold text-[clamp(34px,4.5vw,72px)] leading-[0.98] tracking-[-0.015em] uppercase text-white text-balance">
            Our Proven Kitchen Remodeling Process
          </h2>
        </div>

        <div class="reveal-item max-w-[440px]">
          <p class="m-0 text-[16px] font-light leading-[1.7] text-white/80">
            At Pacific West Home Builders, we pride ourselves on our ability to exceed expectations. Here’s why discerning homeowners choose us:
          </p>
        </div>
      </div>

      <!-- Timeline Container -->
      <div class="relative z-10 mt-[clamp(56px,7vw,104px)]">
        
        <!-- DESKTOP (>= 1024px): Horizontal Progress Line -->
        <div class="hidden lg:block absolute left-0 right-0 top-0 h-[1px] bg-white/20">
          <div id="process-progress-fill-h" class="absolute inset-0 bg-[#AB0000] origin-left scale-x-0 will-change-transform transition-transform duration-150"></div>
        </div>

        <!-- MOBILE / TABLET (< 1024px): Vertical Progress Line on the Left -->
        <div class="lg:hidden absolute left-[5px] top-2 bottom-8 w-[2px] bg-white/20">
          <div id="process-progress-fill-v" class="absolute inset-0 bg-[#AB0000] origin-top scale-y-0 will-change-transform transition-transform duration-150"></div>
        </div>

        <!-- 6 Steps Grid -->
        <div class="flex flex-col lg:grid lg:grid-cols-6 lg:gap-x-7">
          {PROCESS_STEPS.map((st, idx) => (
            <div 
              class="process-step-item relative pl-8 pb-10 last:pb-0 lg:pl-0 lg:pb-0 lg:pt-7" 
              data-step-index={idx}
            >
              <span 
                class="step-node absolute left-[5px] -translate-x-1/2 top-1.5 lg:top-[-4px] lg:left-0 lg:translate-x-0 w-[11px] h-[11px] rounded-full bg-[#111111] border-2 border-white/40 transition-all duration-400 z-10"
              ></span>
              
              <div class="step-num text-[13px] font-medium text-white/50 transition-colors duration-400">
                {idx + 1}
              </div>

              <div class="text-[19px] font-semibold uppercase mt-1 lg:mt-3.5 tracking-[0.01em] leading-[1.2]">
                {st.title}
              </div>

              <p class="mt-2.5 lg:mt-3 text-[14px] font-light leading-[1.7] text-white/75 max-w-[520px] lg:max-w-none m-0">
                {st.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =====================================================================
         SECTION 6: WHY CHOOSE PACIFIC WEST HOME BUILDERS?
         ===================================================================== -->
    <section id="why-choose" class="px-[clamp(20px,4vw,72px)] py-[clamp(88px,10vw,160px)] bg-[#F7F5F2] text-[#1C1B1A] border-b border-[#E2DED7]">
      <div class="reveal-item max-w-[880px]">
        <span class="block w-14 h-[1px] bg-[#AB0000] mb-7"></span>
        <h2 class="font-sans font-semibold text-[clamp(34px,4.4vw,68px)] leading-[0.98] tracking-[-0.015em] uppercase text-[#1C1B1A] text-balance">
          Why Choose Pacific West Home Builders?
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-[clamp(44px,5.5vw,76px)]">
        {WHY_CHOOSE.map((card, idx) => (
          <div 
            class="reveal-item bg-white border border-[#E2DED7] p-8 sm:p-9 flex flex-col justify-start transition-all duration-300 hover:border-[#1C1B1A] hover:shadow-lg group"
            style={`transition-delay: ${idx * 80}ms;`}
          >
            <div class="w-14 h-14 rounded-full bg-[#111111] flex items-center justify-center p-3 mb-7 transition-colors duration-300 group-hover:bg-[#AB0000]">
              <img 
                src={card.icon} 
                alt={card.title} 
                class="w-7 h-7 object-contain brightness-0 invert"
                loading="lazy"
              />
            </div>

            <h3 class="font-sans font-semibold text-[21px] leading-[1.18] uppercase tracking-[-0.01em] text-[#1C1B1A]">
              {card.title}
            </h3>

            <p class="mt-4 text-[15px] font-light leading-[1.7] text-[#55524D] m-0">
              {card.desc}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- =====================================================================
         SECTION 7: GALLERY (All 44 Original Images)
         ===================================================================== -->
    <section id="projects" class="px-[clamp(20px,4vw,72px)] py-[clamp(88px,10vw,160px)] bg-white text-[#1C1B1A]">
      <div class="reveal-item mb-[clamp(40px,5vw,72px)]">
        <span class="block w-14 h-[1px] bg-[#AB0000] mb-7"></span>
        <h2 class="font-sans font-semibold text-[clamp(36px,4.6vw,76px)] leading-[0.98] tracking-[-0.015em] uppercase text-[#1C1B1A]">
          Gallery
        </h2>
      </div>

      <!-- All 44 Original Gallery Photos in Architectural Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {ALL_GAL_SRCS.map((src, idx) => (
          <figure 
            class="gallery-trigger reveal-item relative m-0 aspect-[4/3] w-full overflow-hidden bg-[#EFECE7] group cursor-pointer"
            data-gal-index={idx}
          >
            <img 
              src={src} 
              alt="Kitchen Remodeling" 
              class="w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105"
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </section>

    <!-- =====================================================================
         LIGHTBOX MODAL FOR ALL 44 GALLERY IMAGES
         ===================================================================== -->
    <div 
      id="kitchen-lightbox" 
      class="fixed inset-0 z-[100] bg-black/95 hidden items-center justify-center p-4 sm:p-8 select-none"
      aria-hidden="true"
    >
      <button 
        id="lightbox-close" 
        type="button" 
        class="absolute top-6 right-6 z-20 w-12 h-12 rounded-full bg-white/10 text-white hover:bg-[#AB0000] transition-colors flex items-center justify-center cursor-pointer border-none"
        aria-label="Close gallery"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <button 
        id="lightbox-prev" 
        type="button" 
        class="absolute left-4 sm:left-8 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-white/10 text-white hover:bg-[#AB0000] transition-colors flex items-center justify-center cursor-pointer border-none"
        aria-label="Previous image"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button 
        id="lightbox-next" 
        type="button" 
        class="absolute right-4 sm:right-8 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-white/10 text-white hover:bg-[#AB0000] transition-colors flex items-center justify-center cursor-pointer border-none"
        aria-label="Next image"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="relative max-w-[1200px] max-h-[85vh] w-full flex flex-col items-center">
        <img 
          id="lightbox-img" 
          src="" 
          alt="Gallery preview" 
          class="max-h-[80vh] max-w-full object-contain shadow-2xl"
        />
      </div>
    </div>

    <!-- =====================================================================
         SECTION 8: START YOUR KITCHEN REMODEL TODAY (cta-bg.webp)
         ===================================================================== -->
    <section id="contact" class="relative px-[clamp(20px,4vw,72px)] py-[clamp(96px,12vw,180px)] bg-[#111111] text-white overflow-hidden">
      <img 
        src="/assets/imagery/kitchen/cta-bg.webp" 
        alt="Start Your Kitchen Remodel Today" 
        class="w-full h-full object-cover object-center absolute inset-0 block opacity-40"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/75 to-black/50 pointer-events-none"></div>
      
      <div class="relative z-10 max-w-[820px] reveal-item">
        <span class="block w-14 h-[1px] bg-[#AB0000] mb-7"></span>
        
        <h2 class="font-sans font-semibold text-[clamp(34px,4.5vw,72px)] leading-[0.98] tracking-[-0.015em] uppercase text-white text-balance">
          Start Your Kitchen Remodel Today
        </h2>

        <p class="mt-7 text-[clamp(16px,1.3vw,20px)] font-light leading-[1.75] text-white/90 max-w-[720px]">
          Contact us today to schedule your consultation and begin your journey toward a kitchen remodel that transforms the way you live.
        </p>

        <p class="mt-4 text-[clamp(16px,1.3vw,20px)] font-light leading-[1.75] text-white/85 max-w-[720px]">
          Ready to turn your outdated kitchen into the heart of your dream home? Let Pacific West Home Builders help you create a space that combines beauty, functionality, and value.
        </p>

        <div class="mt-10">
          <a 
            href="tel:8883984499" 
            class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.18em] uppercase px-[30px] py-[18px] bg-[#AB0000] text-white cursor-pointer transition-colors duration-300 hover:bg-[#8F0000]"
          >
            <span>Get in Touch</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ ALL_GAL_SRCS }}>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Hero Circle Follower Logic
    const heroSection = document.getElementById('top');
    const crosshairBox = document.getElementById('crosshair-box');
    const crosshairCircle = document.getElementById('crosshair-circle');

    function setCrosshairPosition(x, y) {
      if (!crosshairBox || !crosshairCircle) return;
      crosshairBox.style.opacity = '1';
      crosshairCircle.style.transform = `translate(${x - 20}px, ${y - 20}px)`;
    }

    if (heroSection && crosshairBox) {
      const rInit = heroSection.getBoundingClientRect();
      setCrosshairPosition(
        Math.round((rInit.width || window.innerWidth) * 0.56),
        Math.round((rInit.height || window.innerHeight) * 0.52)
      );

      if (!window.matchMedia('(hover: none)').matches) {
        heroSection.addEventListener('mousemove', (e) => {
          const r = heroSection.getBoundingClientRect();
          setCrosshairPosition(e.clientX - r.left, e.clientY - r.top);
        });

        const interactiveEls = heroSection.querySelectorAll('button, a');
        interactiveEls.forEach((el) => {
          el.addEventListener('mouseenter', () => {
            crosshairBox.style.opacity = '0';
          });
          el.addEventListener('mouseleave', () => {
            crosshairBox.style.opacity = '1';
          });
        });
      }
    }

    // 2. Key Benefits Interactive Accordion
    const items = Array.from(document.querySelectorAll('.type-item'));
    let activeIdx = 0;

    function setActiveBenefit(idx) {
      if (idx === activeIdx && items[idx]?.classList.contains('is-active')) return;
      activeIdx = idx;

      items.forEach((item, i) => {
        const isCurrent = i === idx;
        const num = item.querySelector('.type-num');
        const name = item.querySelector('.type-name');
        const body = item.querySelector('.type-body');
        const arrow = item.querySelector('.type-arrow svg');

        if (isCurrent) {
          item.classList.add('is-active');
          if (num) num.style.color = '#AB0000';
          if (name) name.style.color = '#1C1B1A';
          if (body) body.style.gridTemplateRows = '1fr';
          if (arrow) {
            arrow.style.transform = 'rotate(45deg)';
            arrow.style.color = '#AB0000';
          }
        } else {
          item.classList.remove('is-active');
          if (num) num.style.color = '#8C877F';
          if (name) name.style.color = '#8C877F';
          if (body) body.style.gridTemplateRows = '0fr';
          if (arrow) {
            arrow.style.transform = 'none';
            arrow.style.color = '#C9C4BB';
          }
        }
      });
    }

    if (items.length > 0) {
      setActiveBenefit(0);
      items.forEach((item, idx) => {
        item.addEventListener('mouseenter', () => {
          if (window.matchMedia('(hover: hover)').matches) {
            setActiveBenefit(idx);
          }
        });
        item.addEventListener('click', (e) => {
          e.preventDefault();
          setActiveBenefit(idx);
        });
      });
    }

    // 3. Process 6-Step Scroll Progress Timeline
    const processSection = document.querySelector('.process-section');
    const fillH = document.getElementById('process-progress-fill-h');
    const fillV = document.getElementById('process-progress-fill-v');
    const stepItems = Array.from(document.querySelectorAll('.process-step-item'));
    const totalSteps = stepItems.length;

    function updateProcess() {
      if (!processSection) return;
      const r = processSection.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.85 - r.top) / (r.height + window.innerHeight * 0.2)));

      if (fillH) fillH.style.transform = `scaleX(${p})`;
      if (fillV) fillV.style.transform = `scaleY(${p})`;

      stepItems.forEach((item, idx) => {
        const threshold = (idx + 0.35) / totalSteps;
        const isOn = p >= threshold;
        const node = item.querySelector('.step-node');
        const num = item.querySelector('.step-num');

        if (isOn) {
          if (node) {
            node.style.background = '#AB0000';
            node.style.borderColor = '#AB0000';
            node.style.boxShadow = '0 0 10px rgba(171, 0, 0, 0.6)';
          }
          if (num) num.style.color = '#ff6b6b';
        } else {
          if (node) {
            node.style.background = '#111111';
            node.style.borderColor = 'rgba(255, 255, 255, 0.4)';
            node.style.boxShadow = 'none';
          }
          if (num) num.style.color = 'rgba(255, 255, 255, 0.5)';
        }
      });
    }

    window.addEventListener('scroll', updateProcess, { passive: true });
    window.addEventListener('resize', updateProcess);
    updateProcess();

    // 4. Fullscreen Lightbox for 44 Gallery Photos
    const lightbox = document.getElementById('kitchen-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const btnClose = document.getElementById('lightbox-close');
    const btnPrev = document.getElementById('lightbox-prev');
    const btnNext = document.getElementById('lightbox-next');
    let currentGalIdx = 0;

    function openLightbox(idx) {
      if (!lightbox || !lightboxImg) return;
      currentGalIdx = (idx + ALL_GAL_SRCS.length) % ALL_GAL_SRCS.length;
      lightboxImg.src = ALL_GAL_SRCS[currentGalIdx];
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('flex');
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.gallery-trigger').forEach((el) => {
      el.addEventListener('click', () => {
        const idx = parseInt(el.getAttribute('data-gal-index') || '0', 10);
        openLightbox(idx);
      });
    });

    if (btnClose) btnClose.addEventListener('click', closeLightbox);
    if (btnPrev) btnPrev.addEventListener('click', () => openLightbox(currentGalIdx - 1));
    if (btnNext) btnNext.addEventListener('click', () => openLightbox(currentGalIdx + 1));

    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
    }

    window.addEventListener('keydown', (e) => {
      if (!lightbox || lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') openLightbox(currentGalIdx - 1);
      if (e.key === 'ArrowRight') openLightbox(currentGalIdx + 1);
    });
  });
</script>

<style>
  #crosshair-box,
  #crosshair-box * {
    pointer-events: none !important;
  }
</style>
