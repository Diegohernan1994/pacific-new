import Header from '../components/Header.astro';
import OtherServices from '../components/OtherServices.astro';
import Footer from '../components/Footer.astro';
import AskUs from '../components/AskUs.astro';

const BENEFITS = [
  {
    n: 'A Kitchen Tailored to Your Life',
    d: 'Your kitchen should complement your daily routine and family’s needs. Whether it’s optimizing the layout for better flow or choosing materials that reflect your unique style, we create kitchens that fit your life seamlessly.',
    src: '/assets/imagery/kitchen/key-benefits.jpg'
  },
  {
    n: 'Enhanced Functionality and Efficiency',
    d: 'Say goodbye to cramped, outdated spaces. A remodel lets you reconfigure your kitchen for better organization, more storage, and upgraded appliances, ensuring every inch works for you.',
    src: '/assets/imagery/kitchen/dream-kitchen.jpg'
  },
  {
    n: 'Boost Your Home’s Value',
    d: 'A beautifully remodeled kitchen is one of the best investments you can make. Not only does it enhance your everyday life, but it also significantly increases your home’s market appeal and resale value.',
    src: '/assets/imagery/kitchen/what-we-bring-bg.webp'
  },
  {
    n: 'A Space That Reflects You',
    d: 'From sleek, modern designs to warm, traditional aesthetics, your remodeled kitchen will be a true reflection of your taste and personality, customized down to the finest detail.',
    src: '/assets/imagery/kitchen/banner.webp'
  }
];

const PROCESS_STEPS = [
  {
    title: 'Consultation and Vision',
    desc: 'We start by understanding your needs, lifestyle, and vision for your new kitchen. Together, we assess your current space and craft a personalized plan that reflects your goals and style.'
  },
  {
    title: 'Detailed Design and Planning',
    desc: 'Our design team creates a customized layout, helping you choose the perfect materials, finishes, and features to bring your vision to life while optimizing functionality.'
  },
  {
    title: '3D Design and Visualization',
    desc: 'See your dream kitchen come to life before construction even begins. Our 3D design renderings provide a realistic preview of your remodeled kitchen, allowing you to finetune every detail and make confident decisions.'
  },
  {
    title: 'Demolition and Preparation',
    desc: 'Our skilled team carefully removes outdated elements, prepares the space for installation, and ensures minimal disruption to your home during this phase.'
  },
  {
    title: 'Construction and Installation',
    desc: 'From structural adjustments to installing cabinets, countertops, lighting, and plumbing, we handle every detail with precision and expert craftsmanship.'
  },
  {
    title: 'Final Touches and Walkthrough',
    desc: 'We complete your space with finishing touches, like backsplashes, hardware, and decorative elements. Finally, a detailed walkthrough ensures your complete satisfaction and ensures every element is exactly as you envisioned.'
  }
];

const WHY_CHOOSE = [
  {
    title: 'Tailored Solutions',
    desc: 'Every kitchen remodel is designed to reflect your unique needs, lifestyle, and personal taste.',
    icon: '/assets/imagery/kitchen/diamond-1.png'
  },
  {
    title: 'Exceptional Quality at Any Budget',
    desc: 'We balance affordability with high-quality materials and craftsmanship to create stunning results without exceeding your budget.',
    icon: '/assets/imagery/kitchen/diamond-1.png'
  },
  {
    title: 'Seamless Communication',
    desc: 'From start to finish, we keep you informed, ensuring every step of the process is smooth and stress-free.',
    icon: '/assets/imagery/kitchen/business-ethics.png'
  },
  {
    title: 'Commitment to Your Vision',
    desc: 'Your satisfaction is our priority. We don’t consider the job done until you’re thrilled with your new kitchen.',
    icon: '/assets/imagery/kitchen/business-ethics.png'
  }
];

const FEATURED_GAL = [
  { src: '/assets/imagery/kitchen/gallery/gal-01.jpg', cap: 'Kitchen Remodeling · 01', c: 1, r: 1, cs: 2, rs: 2 },
  { src: '/assets/imagery/kitchen/gallery/gal-02.jpg', cap: 'Kitchen Remodeling · 02', c: 3, r: 1, cs: 1, rs: 2 },
  { src: '/assets/imagery/kitchen/gallery/gal-03.jpg', cap: 'Kitchen Remodeling · 03', c: 4, r: 1, cs: 1, rs: 1 },
  { src: '/assets/imagery/kitchen/gallery/gal-04.jpg', cap: 'Kitchen Remodeling · 04', c: 4, r: 2, cs: 1, rs: 1 },
  { src: '/assets/imagery/kitchen/gallery/gal-05.jpg', cap: 'Kitchen Remodeling · 05', c: 1, r: 3, cs: 1, rs: 1 },
  { src: '/assets/imagery/kitchen/gallery/gal-06.jpg', cap: 'Kitchen Remodeling · 06', c: 1, r: 4, cs: 1, rs: 1 },
  { src: '/assets/imagery/kitchen/gallery/gal-07.jpg', cap: 'Kitchen Remodeling · 07', c: 2, r: 3, cs: 2, rs: 2 },
  { src: '/assets/imagery/kitchen/gallery/gal-08.jpg', cap: 'Kitchen Remodeling · 08', c: 4, r: 3, cs: 1, rs: 2 },
  { src: '/assets/imagery/kitchen/gallery/gal-09.jpg', cap: 'Kitchen Remodeling · 09', c: 1, r: 5, cs: 2, rs: 2 },
  { src: '/assets/imagery/kitchen/gallery/gal-10.jpg', cap: 'Kitchen Remodeling · 10', c: 3, r: 5, cs: 1, rs: 1 },
  { src: '/assets/imagery/kitchen/gallery/gal-11.jpg', cap: 'Kitchen Remodeling · 11', c: 3, r: 6, cs: 1, rs: 1 },
  { src: '/assets/imagery/kitchen/gallery/gal-12.jpg', cap: 'Kitchen Remodeling · 12', c: 4, r: 5, cs: 1, rs: 2 }
];

const EXTRA_GAL = [
  '/assets/imagery/kitchen/gallery/gal-13.jpg',
  '/assets/imagery/kitchen/gallery/gal-14.png',
  '/assets/imagery/kitchen/gallery/gal-15.png',
  '/assets/imagery/kitchen/gallery/gal-16.png',
  '/assets/imagery/kitchen/gallery/gal-17.png',
  '/assets/imagery/kitchen/gallery/gal-18.jpg',
  '/assets/imagery/kitchen/gallery/gal-19.jpg',
  '/assets/imagery/kitchen/gallery/gal-20.png',
  '/assets/imagery/kitchen/gallery/gal-21.png',
  '/assets/imagery/kitchen/gallery/gal-22.png',
  '/assets/imagery/kitchen/gallery/gal-23.png',
  '/assets/imagery/kitchen/gallery/gal-24.png',
  '/assets/imagery/kitchen/gallery/gal-25.png',
  '/assets/imagery/kitchen/gallery/gal-26.png',
  '/assets/imagery/kitchen/gallery/gal-27.png',
  '/assets/imagery/kitchen/gallery/gal-28.png',
  '/assets/imagery/kitchen/gallery/gal-29.png',
  '/assets/imagery/kitchen/gallery/gal-30.png',
  '/assets/imagery/kitchen/gallery/gal-31.png',
  '/assets/imagery/kitchen/gallery/gal-32.png',
  '/assets/imagery/kitchen/gallery/gal-33.png',
  '/assets/imagery/kitchen/gallery/gal-34.png',
  '/assets/imagery/kitchen/gallery/gal-35.png',
  '/assets/imagery/kitchen/gallery/gal-36.png',
  '/assets/imagery/kitchen/gallery/gal-37.png',
  '/assets/imagery/kitchen/gallery/gal-38.png',
  '/assets/imagery/kitchen/gallery/gal-39.png',
  '/assets/imagery/kitchen/gallery/gal-40.png',
  '/assets/imagery/kitchen/gallery/gal-41.png',
  '/assets/imagery/kitchen/gallery/gal-42.png',
  '/assets/imagery/kitchen/gallery/gal-43.png',
  '/assets/imagery/kitchen/gallery/gal-44.png'
];

const ALL_GAL_SRCS = [
  ...FEATURED_GAL.map(g => g.src),
  ...EXTRA_GAL
];
---

<Layout 
  title="Kitchen Remodeling · Pacific West Home Builders"
  description="Transform Your Kitchen with Pacific West Home Builders. Custom kitchen remodeling, 3D design, cabinetry, countertops, and full installation across Southern California."
>
  <Header />

  <main class="w-full">
    
    <!-- =====================================================================
         SECTION 1: HERO (100% Verbatim Copy & Original Banner)
         ===================================================================== -->
    <section id="top" class="relative h-screen min-h-[680px] w-full overflow-hidden bg-[#111111] text-white select-none">
      <!-- Background Image Layer (z-index: 1) -->
      <div class="absolute inset-0 pt-[84px] z-[1]">
        <div class="w-full h-full overflow-hidden">
          <img 
            src="/assets/imagery/kitchen/banner.webp" 
            alt="Transform Your Kitchen with Pacific West Home Builders" 
            class="w-full h-full object-cover object-center block scale-[1.02] transition-transform duration-[2600ms] ease-out"
            loading="eager"
          />
        </div>
      </div>

      <!-- Architectural Gradient Vignette Layer (z-index: 2) -->
      <div 
        class="absolute inset-0 z-[2] pointer-events-none"
        style="background: linear-gradient(180deg, rgba(0,0,0,0.15) 25%, rgba(0,0,0,0.78) 100%), linear-gradient(90deg, rgba(0,0,0,0.55), rgba(0,0,0,0) 65%);"
      ></div>

      <!-- Architectural Circle Follower Layer (z-index: 3) -->
      <div id="crosshair-box" aria-hidden="true" class="absolute inset-0 pointer-events-none transition-opacity duration-300 z-[3]" style="opacity: 1; pointer-events: none !important;">
        <div id="crosshair-circle" class="absolute left-0 top-0 w-10 h-10 rounded-full border border-[#AB0000] grid place-items-center will-change-transform pointer-events-none" style="pointer-events: none !important;">
          <span class="w-1 h-1 rounded-full bg-[#AB0000] pointer-events-none" style="pointer-events: none !important;"></span>
        </div>
      </div>

      <!-- Hero Content (z-index: 4) -->
      <div class="absolute z-[4] left-[clamp(20px,4vw,72px)] right-[clamp(20px,4vw,72px)] bottom-[clamp(64px,11vh,128px)] max-w-[1040px] pointer-events-none">
        <!-- Eyebrow / Subtitles from Original Page -->
        <div class="flex items-center gap-4 flex-wrap text-[12px] font-semibold tracking-[0.24em] uppercase text-[#ff6b6b]" style="animation: v4Rise 0.8s var(--ease-out) both;">
          <span class="w-14 h-[1px] bg-[#ff6b6b]"></span>
          <span>Kitchen Remodeling</span>
          <span class="text-white/40">·</span>
          <span class="text-white/85">Pacific West Home Builders</span>
        </div>

        <!-- Verbatim H1 -->
        <h1 class="mt-6 font-sans font-semibold text-[clamp(36px,5.2vw,92px)] leading-[0.95] tracking-[-0.02em] uppercase text-balance text-white" style="animation: v4Rise 0.9s var(--ease-out) 80ms both;">
          Transform Your Kitchen with Pacific West Home Builders
        </h1>

        <!-- Verbatim CTA Button -->
        <div class="flex gap-3 flex-wrap mt-[34px] pointer-events-auto" style="animation: v4Rise 0.9s var(--ease-out) 180ms both;">
          <button 
            type="button" 
            onclick="window.go('contact')"
            class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.18em] uppercase px-[28px] py-[18px] bg-[#AB0000] text-white cursor-pointer transition-colors duration-300 hover:bg-[#8F0000]"
          >
            <span>CONTACT US NOW</span>
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- Scroll Prompt (z-index: 50) -->
      <a 
        href="#dream-kitchen" 
        id="scroll-prompt" 
        onclick="event.preventDefault(); window.go('dream-kitchen');"
        class="absolute z-50 left-0 right-0 bottom-7 mx-auto w-fit flex items-center gap-3 text-[11px] tracking-[0.3em] text-white/80 hover:text-white cursor-pointer transition-colors duration-200 outline-none select-none bg-transparent border-none p-3 pointer-events-auto" 
        style="animation: v4Rise 1s var(--ease-out) 0.6s both; pointer-events: auto !important;"
        aria-label="Scroll to next section"
      >
        <span>SCROLL TO EXPLORE</span>
        <svg class="w-3.5 h-3.5 text-white animate-bounce pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </a>

      <!-- Bottom Accent Line -->
      <div class="absolute z-[4] left-0 right-0 bottom-0 h-1 bg-white/10">
        <div class="h-full w-full bg-[#AB0000]"></div>
      </div>
    </section>

    <!-- =====================================================================
         SECTION 2: YOUR DREAM KITCHEN, DESIGNED JUST FOR YOU
         ===================================================================== -->
    <section id="dream-kitchen" class="px-[clamp(20px,4vw,72px)] py-[clamp(88px,10vw,160px)] bg-[#F7F5F2] text-[#1C1B1A]">
      <div class="grid grid-cols-1 min-[901px]:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] gap-[clamp(36px,6vw,96px)] items-center">
        
        <!-- Left Column: Verbatim Copy -->
        <div class="reveal-item">
          <div class="flex items-center gap-4 text-[12px] font-semibold tracking-[0.24em] uppercase text-[#AB0000]">
            <span class="w-14 h-[1px] bg-[#AB0000]"></span>
            <span>Kitchen Remodeling</span>
          </div>

          <h2 class="mt-7 font-sans font-semibold text-[clamp(34px,4.4vw,68px)] leading-[0.98] tracking-[-0.015em] uppercase text-[#1C1B1A] text-balance">
            Your Dream Kitchen, Designed Just for You
          </h2>

          <div class="mt-8 space-y-6 text-[16px] sm:text-[17px] font-light leading-[1.75] text-[#55524D] max-w-[640px]">
            <p class="m-0">
              The kitchen is the heart of the home—a space where family and friends gather, where creativity comes alive, and where lasting memories are made. At Pacific West Home Builders, we believe everyone deserves a kitchen that fits their style, meets their needs, and stays within their budget. we specialize in transforming outdated kitchens into functional, beautiful, and inviting spaces that elevate your home’s style and functionality.
            </p>
            <p class="m-0">
              Whether you’re envisioning a modern space with sleek finishes or a cozy, timeless kitchen, we are here to bring your dream to life. With a focus on personalized solutions, unmatched professionalism, and thoughtful planning, we transform kitchens into spaces you’ll love for years to come.
            </p>
          </div>

          <div class="mt-10">
            <button 
              type="button" 
              onclick="window.go('contact')"
              class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.18em] uppercase px-[26px] py-[17px] bg-[#111111] text-white cursor-pointer transition-colors duration-300 hover:bg-[#AB0000]"
            >
              <span>CONTACT US NOW</span>
            </button>
          </div>
        </div>

        <!-- Right Column: Original Section Image (dream-kitchen.jpg) -->
        <div class="reveal-item relative aspect-[4/3] sm:aspect-[5/4] w-full overflow-hidden bg-[#E2DED7] shadow-xl group">
          <img 
            src="/assets/imagery/kitchen/dream-kitchen.jpg" 
            alt="Your Dream Kitchen, Designed Just for You" 
            class="w-full h-full object-cover object-center block transition-transform duration-[1400ms] ease-out group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute left-0 top-0 z-[2] bg-[#111111] text-white px-[18px] py-3 text-[11px] font-semibold tracking-[0.2em] uppercase pointer-events-none shadow-md">
            Pacific West · Custom Kitchens
          </div>
        </div>

      </div>
    </section>

    <!-- =====================================================================
         SECTION 3: WHAT WE BRING TO YOUR KITCHEN REMODEL (what-we-bring-bg.webp)
         ===================================================================== -->
    <section id="what-we-bring" class="relative px-[clamp(20px,4vw,72px)] py-[clamp(96px,11vw,176px)] bg-[#111111] text-white overflow-hidden">
      <!-- Original Section Background Image -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/assets/imagery/kitchen/what-we-bring-bg.webp" 
          alt="What We Bring to Your Kitchen Remodel" 
          class="w-full h-full object-cover object-center block opacity-35"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#111111] via-[#111111]/85 to-[#111111]/65"></div>
      </div>

      <div class="relative z-10 max-w-[960px] reveal-item">
        <div class="flex items-center gap-4 text-[12px] font-semibold tracking-[0.24em] uppercase text-[#ff6b6b]">
          <span class="w-14 h-[1px] bg-[#ff6b6b]"></span>
          <span>Pacific West Home Builders</span>
        </div>

        <h2 class="mt-7 font-sans font-semibold text-[clamp(34px,4.6vw,72px)] leading-[0.98] tracking-[-0.015em] uppercase text-white text-balance">
          What We Bring to Your Kitchen Remodel
        </h2>

        <p class="mt-8 text-[clamp(16px,1.35vw,21px)] font-light leading-[1.75] text-white/90 max-w-[860px]">
          We design kitchens that maximize space and functionality, creating a seamless flow for cooking, entertaining, and dining. Custom storage solutions, such as soft-close drawers, pull-out shelves, and built-in organizers, keep everything organized and clutter-free. High-quality finishes, including quartz or granite countertops and tile, glass, or stone backsplashes, add durability and style. Stylish and durable flooring options, such as hardwood, tile, or luxury vinyl, combined with layered lighting solutions like task lighting and decorative pendants, create the perfect ambiance.
        </p>

        <!-- Architectural Highlight Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 mt-12 pt-10 border-t border-white/15">
          <div>
            <div class="text-[11px] font-semibold tracking-[0.2em] uppercase text-[#ff6b6b]">01 · Storage</div>
            <div class="mt-2 text-[15px] font-medium text-white">Soft-Close & Pull-Out Organizers</div>
          </div>
          <div>
            <div class="text-[11px] font-semibold tracking-[0.2em] uppercase text-[#ff6b6b]">02 · Surfaces</div>
            <div class="mt-2 text-[15px] font-medium text-white">Quartz, Granite & Stone Backsplashes</div>
          </div>
          <div>
            <div class="text-[11px] font-semibold tracking-[0.2em] uppercase text-[#ff6b6b]">03 · Flooring</div>
            <div class="mt-2 text-[15px] font-medium text-white">Hardwood, Tile & Luxury Vinyl</div>
          </div>
          <div>
            <div class="text-[11px] font-semibold tracking-[0.2em] uppercase text-[#ff6b6b]">04 · Lighting</div>
            <div class="mt-2 text-[15px] font-medium text-white">Layered Task & Decorative Pendants</div>
          </div>
        </div>
      </div>
    </section>

    <!-- =====================================================================
         SECTION 4: WHY REMODEL & KEY BENEFITS (Interactive Split Accordion)
         ===================================================================== -->
    <section id="types" class="px-[clamp(20px,4vw,72px)] py-[clamp(88px,10vw,160px)] bg-[#F7F5F2] text-[#1C1B1A]">
      <!-- Section Header -->
      <div class="flex justify-between items-end gap-8 flex-wrap mb-[clamp(48px,6vw,88px)]">
        <div class="reveal-item max-w-[780px]">
          <div class="flex items-center gap-4 text-[12px] font-semibold tracking-[0.24em] uppercase text-[#AB0000]">
            <span class="w-14 h-[1px] bg-[#AB0000]"></span>
            <span>Key Benefits of Remodeling Your Kitchen</span>
          </div>
          <h2 class="mt-7 font-sans font-semibold text-[clamp(34px,4.4vw,68px)] leading-[0.98] tracking-[-0.015em] uppercase text-[#1C1B1A] text-balance">
            Why Remodel Your Kitchen with Pacific West Home Builders?
          </h2>
        </div>

        <div class="reveal-item max-w-[460px]">
          <p class="m-0 text-[16px] font-light leading-[1.7] text-[#55524D]">
            A kitchen remodel is more than just an upgrade—it’s an opportunity to transform your space into the heart of your home. At Pacific West Home Builders, we specialize in designing kitchens that are tailored to your lifestyle, budget, and personal style, delivering spaces that are as functional as they are beautiful.
          </p>
        </div>
      </div>

      <!-- Interactive Split Grid (Matches Home Types.astro) -->
      <div class="v4-types grid grid-cols-1 min-[901px]:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] gap-[clamp(32px,5vw,88px)] items-start">
        
        <!-- Left Column: Accordion Selector -->
        <div>
          <div class="text-[13px] font-semibold tracking-[0.2em] uppercase text-[#1C1B1A] mb-5">
            Key Benefits of Remodeling Your Kitchen
          </div>

          <div class="border-t border-[#1C1B1A]">
            {BENEFITS.map((b, idx) => (
              <div 
                class="type-item border-b border-[#E2DED7] py-7 cursor-pointer group"
                data-type-index={idx}
                data-type-name={b.n}
              >
                <div class="flex items-baseline gap-6">
                  <span class="type-num text-[13px] font-medium text-[#8C877F] min-w-[24px] transition-colors duration-300">
                    {String(idx + 1).padStart(2, '0')}
                  </span>

                  <div class="flex-1 min-w-0">
                    <div class="type-name text-[clamp(22px,2.2vw,34px)] font-semibold uppercase tracking-[-0.01em] leading-[1.08] text-[#8C877F] transition-colors duration-300">
                      {b.n}
                    </div>

                    <div class="type-body grid transition-all duration-500 ease-out overflow-hidden" style={idx === 0 ? 'grid-template-rows: 1fr;' : 'grid-template-rows: 0fr;'}>
                      <div class="overflow-hidden">
                        <p class="mt-4 text-[15px] sm:text-[16px] font-light leading-[1.7] text-[#55524D] max-w-[540px]">
                          {b.d}
                        </p>
                      </div>
                    </div>
                  </div>

                  <!-- Arrow Indicator -->
                  <div class="type-arrow text-[#C9C4BB] transition-all duration-400 group-hover:text-[#AB0000]">
                    <svg class="w-[22px] h-[22px] transition-transform duration-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- CTA -->
          <div class="mt-9">
            <button 
              type="button" 
              onclick="window.go('contact')"
              class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.18em] uppercase px-[26px] py-[17px] bg-[#111111] text-white cursor-pointer transition-colors duration-300 hover:bg-[#AB0000]"
            >
              <span>Start Your Kitchen Remodel</span>
            </button>
          </div>
        </div>

        <!-- Right Column: Sticky Image Preview (Unanchored on mobile via .v4-type-img in global.css) -->
        <div class="v4-type-img sticky top-[120px] aspect-[4/5] max-h-[calc(100vh-160px)] w-full overflow-hidden bg-[#E2DED7] shadow-lg">
          {BENEFITS.map((b, idx) => (
            <div 
              class={`type-image-pane absolute inset-0 transition-all duration-700 ease-in-out ${idx === 0 ? 'opacity-100 scale-100 z-10 pointer-events-auto' : 'opacity-0 scale-105 z-0 pointer-events-none'}`}
              data-img-index={idx}
            >
              <img 
                src={b.src} 
                alt={b.n} 
                class="w-full h-full object-cover object-center block"
                loading="lazy"
              />
            </div>
          ))}

          <!-- Top Badge -->
          <div id="type-badge" class="absolute left-0 top-0 z-[2] bg-[#111111] text-white px-[18px] py-3 text-[11px] font-semibold tracking-[0.2em] uppercase pointer-events-none shadow-md">
            01 / 04 · A Kitchen Tailored to Your Life
          </div>
        </div>

      </div>
    </section>

    <!-- =====================================================================
         SECTION 5: OUR PROVEN KITCHEN REMODELING PROCESS (6-Step Timeline)
         ===================================================================== -->
    <section id="process" class="process-section relative px-[clamp(20px,4vw,72px)] py-[clamp(88px,10vw,160px)] bg-[#111111] text-white overflow-hidden">
      <!-- Original Process Background Image (process-bg.webp) -->
      <div class="absolute inset-0 z-0 pointer-events-none">
        <img 
          src="/assets/imagery/kitchen/process-bg.webp" 
          alt="Our Proven Kitchen Remodeling Process" 
          class="w-full h-full object-cover object-center block opacity-20"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#111111]/95 via-[#111111]/85 to-[#111111]/95"></div>
      </div>

      <!-- Section Title & Verbatim Subtitle -->
      <div class="relative z-10 flex justify-between items-end gap-8 flex-wrap">
        <div class="reveal-item max-w-[820px]">
