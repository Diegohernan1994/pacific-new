---
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Thank You · Pacific West Home Builders</title>
  <link rel="icon" type="image/png" href="/assets/logo-black.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Poppins:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,600;1,700;1,800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body class="bg-[#111111] text-white font-sans antialiased m-0 p-0 overflow-hidden">
  
  <main class="relative h-screen min-h-[100dvh] w-full flex flex-col justify-between items-center px-6 py-8 overflow-hidden select-none">
    
    <!-- Background Image with Scrim & Backdrop Blur -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/imagery/build/00-completed-adu-hero.png" 
        alt="Pacific West ADU Architecture" 
        class="w-full h-full object-cover filter brightness-[0.35] scale-105"
      />
      <div class="absolute inset-0 bg-[#111111]/75 backdrop-blur-md"></div>
    </div>

    <!-- Top Block: Brand Logo -->
    <header class="relative z-10 w-full max-w-5xl flex justify-center pt-2">
      <a href="/" class="transition-opacity hover:opacity-90">
        <img src="/assets/logo-white.png" alt="Pacific West Home Builders" class="h-12 w-auto block" />
      </a>
    </header>

    <!-- Center Block: Editorial Confirmation Message -->
    <div class="relative z-10 max-w-2xl text-center flex flex-col items-center my-auto py-6">
      <!-- Eyebrow -->
      <div class="text-[12px] font-semibold tracking-[0.26em] uppercase text-[#ff6b6b] mb-4">
        REQUEST RECEIVED
      </div>

      <!-- Main Headline -->
      <h1 class="font-sans font-semibold text-[clamp(32px,5vw,56px)] leading-[1.05] tracking-[-0.02em] uppercase text-white m-0 text-balance">
        Thank You for Reaching Out
      </h1>

      <!-- Brand Accent Line -->
      <div class="w-16 h-[2px] bg-[#AB0000] my-6"></div>

      <!-- Body Copy -->
      <p class="font-light text-[clamp(15px,1.4vw,18px)] leading-[1.7] text-white/85 max-w-lg m-0">
        Our ADU design and permitting team has received your inquiry. A specialist will review your property details and contact you shortly to coordinate your free site evaluation.
      </p>

      <!-- Immediate Call Backup & Return Home -->
      <div class="flex flex-col sm:flex-row items-center gap-4 mt-8">
        <a 
          href="tel:8883984499" 
          class="inline-flex items-center gap-3 font-sans text-[12px] font-semibold tracking-[0.18em] uppercase px-7 py-4 bg-[#AB0000] text-white transition-colors duration-300 hover:bg-[#8F0000]"
        >
          <span>Call Us: (888) 398-4499</span>
        </a>

        <a 
          href="/" 
          class="inline-flex items-center gap-2 font-sans text-[12px] font-medium tracking-[0.16em] uppercase px-6 py-4 border border-white/30 text-white/90 transition-all duration-300 hover:bg-white hover:text-black hover:border-white"
        >
          <span>Return to Homepage</span>
        </a>
      </div>
    </div>

    <!-- Bottom Block: Footer CSLB & Copyright -->
    <footer class="relative z-10 w-full max-w-5xl flex flex-col sm:flex-row justify-between items-center gap-2 pt-4 border-t border-white/10 text-[11px] font-light text-white/50 text-center">
      <span>Pacific West Home Builders © 2026 · CSLB License #1111181</span>
      <span>Encino & Pasadena, California · info@pwhbuilders.com</span>
    </footer>

  </main>

</body>
</html>
