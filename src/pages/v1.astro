---
import Layout from '../layouts/Layout.astro';
import Header from '../components/v1/Header.astro';
import BuildHero from '../components/v1/BuildHero.astro';
import Types from '../components/v1/Types.astro';
import Process from '../components/v1/Process.astro';
import Gallery from '../components/v1/Gallery.astro';
import Calculator from '../components/v1/Calculator.astro';
import OtherServices from '../components/v1/OtherServices.astro';
import Reviews from '../components/v1/Reviews.astro';
import Faq from '../components/v1/Faq.astro';
import Contact from '../components/v1/Contact.astro';
import Footer from '../components/v1/Footer.astro';
import AskUs from '../components/v1/AskUs.astro';
---

<Layout 
  title="Pacific West Home Builders · ADUs (v1)"
  description="Pacific West designs, permits and builds accessory dwelling units across Southern California. Custom detached ADUs, garage conversions, and additions."
>
  <Header />
  
  <main class="w-full">
    <BuildHero />
    <Types />
    <Process />
    <Gallery />
    <Calculator />
    <OtherServices />
    <Reviews />
    <Faq />
    <Contact />
  </main>

  <Footer />
  <AskUs />
</Layout>
