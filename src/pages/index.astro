---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BuildHero from '../components/BuildHero.astro';
import Types from '../components/Types.astro';
import Process from '../components/Process.astro';
import Gallery from '../components/Gallery.astro';
import Calculator from '../components/Calculator.astro';
import OtherServices from '../components/OtherServices.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import AskUs from '../components/AskUs.astro';
import { getHomeContent, getAduTypes } from '../lib/sanity-content.js';

const [home, aduTypes] = await Promise.all([getHomeContent(), getAduTypes()]);
---

<Layout 
  title="Pacific West Home Builders · ADUs"
  description="Pacific West designs, permits and builds accessory dwelling units across Southern California. Custom detached ADUs, garage conversions, and additions."
>
  <Header />
  
  <main class="w-full">
    <BuildHero stages={home.heroStages} />
    <Types items={aduTypes} content={home.types} />
    <Process content={home.process} />
    <Gallery content={home.gallery} />
    <Calculator />
    <OtherServices />
    <Reviews items={home.testimonials} />
    <Faq content={home.faq} />
    <Contact title={home.contact.title} kicker={home.contact.kicker} intro={home.contact.intro} image={home.contact.imageUrl} imageAlt={home.contact.imageAlt} />
  </main>
  <Footer />
  <AskUs />
</Layout>
