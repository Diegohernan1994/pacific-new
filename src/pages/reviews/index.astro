---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageCTA from '../../components/PageCTA.astro';
import Contact from '../../components/Contact.astro';
import { getPortfolioContent } from '../../lib/sanity-content.js';

const { reviews, reviewPlatforms } = await getPortfolioContent();

const categories = [
  { id: 'all', label: 'All' },
  { id: 'adu', label: 'ADU' },
  { id: 'construction', label: 'Construction' },
  { id: 'remodel', label: 'Remodel' }
];
const countFor = (id) => id === 'all' ? reviews.length : reviews.filter((review) => review.category === id).length;
---

<Layout
  title="Reviews | Pacific West Home Builders"
  description="Read what homeowners say about their ADU, construction and remodeling projects with Pacific West Home Builders."
  canonical="https://pwhbuilders.com/reviews/"
>
  <Header />
  <main class="reviews-page">
    <section class="reviews-hero">
      <div class="eyebrow"><a href="/">Home</a><span>/</span><span>Reviews</span></div>
      <div class="reviews-hero-grid">
        <div>
          <p class="section-label"><span></span>Client reviews</p>
          <h1>Reviews</h1>
          <p class="hero-lead">What homeowners say after building with Pacific West, in their own words.</p>
        </div>
        <div class="rating-summary" aria-label="Average rating: 5 out of 5 stars">
          <span class="rating-number">5.0</span>
          <div class="rating-detail">
            <div class="stars" aria-hidden="true">{Array.from({ length: 5 }, (_, i) => <span key={i}>★</span>)}</div>
            <p>Average rating across<br />Google and Yelp</p>
          </div>
        </div>
      </div>
      <div class="review-filters" role="group" aria-label="Filter reviews">
        {categories.map((category, index) => (
          <button
            type="button"
            class:list={['filter-button', { active: index === 0 }]}
            data-review-filter={category.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {category.label}<span>{countFor(category.id)}</span>
          </button>
        ))}
      </div>
    </section>

    <section id="reviews" class="review-list" aria-label="Customer reviews">
      {reviews.map((review, index) => (
        <article class="review-card" data-review-card data-category={review.category}>
          <div class="review-image-wrap">
            <img src={review.image} alt={`${review.project} project`} loading={index === 0 ? 'eager' : 'lazy'} />
            <span class="project-tag">{review.project}</span>
          </div>
          <div class="review-copy">
            <div class="review-meta">
              <div class="stars" aria-label="5 out of 5 stars">{Array.from({ length: 5 }, (_, i) => <span aria-hidden="true" key={i}>★</span>)}</div>
              <span class="review-platform"><span class:list={['platform-mark', review.platform.toLowerCase()]} aria-hidden="true">{review.platform === 'Google' ? 'G' : '✣'}</span>{review.platform}</span>
            </div>
            <blockquote>“{review.quote}”</blockquote>
            <div class="review-author"><span></span><strong>{review.name}</strong><small>{review.project}</small></div>
          </div>
        </article>
      ))}
      <p class="no-reviews" hidden>No reviews found in this category.</p>
    </section>

    <section class="review-platforms">
      <div class="platform-heading">
        <div>
          <p class="section-label"><span></span>Find us on</p>
          <h2>Read more reviews</h2>
        </div>
        <p>See every review on the platforms where our clients post them, or leave your own.</p>
      </div>
      <div class="platform-grid">
        {reviewPlatforms.map((platform) => (
          <a href={platform.href} target="_blank" rel="noopener noreferrer" class="platform-link">
            <span><i class:list={['platform-mark', platform.name.toLowerCase()]} aria-hidden="true">{platform.name === 'Google' ? 'G' : platform.name === 'Yelp' ? '✣' : '↗'}</i>{platform.name}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <PageCTA kicker="Your project next" title="Join our happy homeowners" actionHref="/contact/" actionLabel="Start your project" image="/assets/imagery/reviews-projects/build/08-completed.jpg" />
  <Contact
    title="Let’s talk about your next project"
    kicker="Tell us what you’re planning"
    intro="Share a few details and our team will help you plan the next step."
    label="Project type"
    options={['Detached ADU', 'Attached ADU', 'Garage Conversion', 'JADU', 'Second-story ADU', 'Kitchen Remodeling', 'Bathroom Remodeling', 'Room Addition', 'Other']}
    selectPlaceholder="Select project type"
    image="/assets/imagery/reviews-projects/clean/kitchen-green-cabinets.jpg"
    imageAlt="Kitchen remodeled by Pacific West Home Builders"
    landing="reviews-page"
  />
  <Footer />
</Layout>

<script>
  const filterButtons = Array.from(document.querySelectorAll('[data-review-filter]'));
  const reviewCards = Array.from(document.querySelectorAll('[data-review-card]'));
  const emptyState = document.querySelector('.no-reviews');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.reviewFilter;
      let visible = 0;
      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      reviewCards.forEach((card) => {
        const show = selected === 'all' || card.dataset.category === selected;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (emptyState) emptyState.hidden = visible > 0;
    });
  });
</script>

<style>
  .reviews-page{background:#f7f5f2;color:#1c1b1a}
  .reviews-hero{padding:calc(84px + clamp(52px,7vw,104px)) clamp(20px,4vw,72px) clamp(42px,5vw,72px);background:#111;color:#fff}
  .eyebrow{display:flex;gap:10px;align-items:center;color:rgba(255,255,255,.55);font-size:11px;letter-spacing:.16em;text-transform:uppercase}
  .eyebrow a{color:inherit}.eyebrow span:nth-child(2){color:#ab0000}
  .reviews-hero-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:48px clamp(32px,6vw,120px);align-items:end;margin-top:40px}
  .section-label{display:flex;align-items:center;gap:14px;margin:0;color:#ff6b6b;font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase}
  .section-label span{width:48px;height:1px;background:#ab0000}
  .reviews-hero h1{margin:24px 0 0;font-size:clamp(54px,8vw,104px);line-height:.92;letter-spacing:-.035em;font-weight:600;text-transform:uppercase;animation:reviewsRise .8s ease both}
  .hero-lead{max-width:600px;margin:24px 0 0;color:rgba(255,255,255,.76);font-size:clamp(16px,1.4vw,19px);font-weight:300;line-height:1.65}
  .rating-summary{display:flex;align-items:center;gap:24px;animation:reviewsRise .8s ease 120ms both}
  .rating-number{font-size:clamp(76px,9vw,120px);font-weight:600;line-height:.8;letter-spacing:-.05em}
  .rating-detail p{margin:10px 0 0;color:rgba(255,255,255,.65);font-size:13px;line-height:1.5;font-weight:300}
  .stars{display:flex;gap:3px;color:#ab0000;font-size:18px;line-height:1}
  .review-filters{display:flex;flex-wrap:wrap;gap:8px;margin-top:clamp(40px,5vw,60px)}
  .filter-button{display:inline-flex;align-items:center;gap:10px;padding:12px 16px;border:1px solid rgba(255,255,255,.24);background:transparent;color:rgba(255,255,255,.78);font-family:inherit;font-size:12px;font-weight:500;letter-spacing:.06em;cursor:pointer;transition:background .2s,color .2s,border .2s}
  .filter-button span{opacity:.55}.filter-button:hover,.filter-button.active{border-color:#ab0000;background:#ab0000;color:#fff}
  .review-list{padding:0 clamp(20px,4vw,72px) clamp(72px,9vw,128px);background:#fff}
  .review-card{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:28px clamp(32px,5vw,96px);padding:clamp(40px,5vw,72px) 0;border-top:1px solid #dedbd6}
  .review-card:first-child{border-color:#1c1b1a}.review-card[hidden]{display:none}
  .review-image-wrap{position:relative;aspect-ratio:4/3;overflow:hidden;background:#e9e6e1}
  .review-image-wrap img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .8s ease}.review-card:hover .review-image-wrap img{transform:scale(1.035)}
  .project-tag{position:absolute;top:0;left:0;padding:9px 13px;background:#111;color:white;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}
  .review-copy{display:flex;flex-direction:column}.review-meta{display:flex;align-items:center;justify-content:space-between;gap:16px}
  .review-platform{display:flex;align-items:center;gap:8px;color:#55524d;font-size:12px;font-weight:500}
  .platform-mark{display:inline-grid;width:24px;height:24px;place-items:center;font-style:normal;font-weight:700;font-size:17px;color:#4285f4}
  .platform-mark.yelp{color:#d32323}.platform-mark.google{color:#4285f4}
  .review-copy blockquote{margin:28px 0 24px;color:#1c1b1a;font-size:clamp(19px,1.7vw,26px);font-weight:300;line-height:1.5;letter-spacing:-.005em;text-wrap:pretty}
  .review-author{display:flex;align-items:center;gap:14px;margin-top:auto;font-size:12px;letter-spacing:.12em;text-transform:uppercase}.review-author>span{width:40px;height:1px;background:#ab0000}.review-author strong{font-weight:600}.review-author small{color:#77736d;font-size:11px;font-weight:300}
  .review-platforms{padding:clamp(72px,9vw,128px) clamp(20px,4vw,72px);background:#f7f5f2}
  .platform-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap;margin-bottom:clamp(36px,5vw,64px)}
  .platform-heading h2{margin:24px 0 0;font-size:clamp(32px,4.6vw,64px);line-height:.98;font-weight:600;letter-spacing:-.025em;text-transform:uppercase}
  .platform-heading>p{max-width:420px;margin:0;color:#68645f;font-size:16px;font-weight:300;line-height:1.7}
  .platform-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
  .platform-link{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:26px 22px;background:#fff;border:1px solid #dedbd6;color:#1c1b1a;font-size:16px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;transition:border-color .2s,transform .2s}
  .platform-link:hover{border-color:#1c1b1a;transform:translateY(-2px)}.platform-link>span:first-child{display:flex;align-items:center;gap:12px}
  .no-reviews{margin:32px 0;color:#68645f}
  @keyframes reviewsRise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
  @media(max-width:900px){.reviews-hero-grid,.review-card{grid-template-columns:minmax(0,1fr)}.rating-summary{margin-top:10px}.review-card{gap:24px}}
  @media(max-width:760px){.reviews-hero{padding-top:calc(84px + 38px)}.reviews-hero h1{font-size:clamp(48px,13vw,72px)}.rating-number{font-size:82px}.review-image-wrap{aspect-ratio:4/3}.platform-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.platform-link{padding:20px 14px;font-size:13px}.platform-grid>:last-child:nth-child(odd){grid-column:1/-1}}
  @media(prefers-reduced-motion:reduce){.reviews-page *{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
</style>
